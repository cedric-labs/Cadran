root = true

# ==============================================================================
# Réglages généraux pour tous les fichiers
# ==============================================================================
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ==============================================================================
# Conventions C# ("Code Humain" & Idiomatique .NET 9)
# ==============================================================================
[*.cs]

# Espaces de noms file-scoped (namespace Ledger...;) pour éviter un niveau d'indentation inutile
csharp_style_namespace_declarations = file_scoped:warning

# Directives using en dehors du namespace et triées avec System.* en premier
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Préférences de lisibilité sur var
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent

# Pattern matching moderne et lisible
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_extended_property_pattern = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning

# Qualification this. inutile (les champs privés utilisent le préfixe _)
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Conventions de nommage : Interfaces en I*, Types/Méthodes en PascalCase
dotnet_naming_rule.interfaces_should_be_begun_with_i.severity = warning
dotnet_naming_rule.interfaces_should_be_begun_with_i.symbols = interface
dotnet_naming_rule.interfaces_should_be_begun_with_i.style = begins_with_i

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# ==============================================================================
# Calibration des analyseurs Meziantou & Roslynator pour ASP.NET Core / EF Core
# ==============================================================================
# Le code de service ne doit pas dépendre d'un contexte de synchronisation pour rester réutilisable hors ASP.NET Core, notamment par le lanceur
dotnet_diagnostic.MA0004.severity = warning

# Les comparaisons de chaînes et les conversions de format doivent être explicites pour rester indépendantes de la culture du poste
dotnet_diagnostic.MA0002.severity = warning
dotnet_diagnostic.MA0006.severity = warning
dotnet_diagnostic.MA0011.severity = warning
dotnet_diagnostic.MA0023.severity = warning
dotnet_diagnostic.MA0074.severity = warning
dotnet_diagnostic.CA1304.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1307.severity = warning
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.CA1311.severity = warning

# Une méthode de production de plus de 60 lignes ou 40 instructions doit être découpée en composants métier nommés (Règle 4) ; les tests en sont exclus ci-dessous
dotnet_diagnostic.MA0051.severity = warning

# Autoriser plusieurs DTOs/Modèles cohésifs dans un même fichier de Vertical Slice
dotnet_diagnostic.MA0048.severity = none

# Les listes/collections sur les entités EF Core et PageModels Razor doivent rester mutables pour le Model Binding
dotnet_diagnostic.MA0016.severity = none
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA2227.severity = none

# ==============================================================================
# Exclusions pour le code généré (Migrations EF Core)
# ==============================================================================
[**/Migrations/*.cs]
generated_code = true
csharp_style_namespace_declarations = block_scoped:silent
dotnet_diagnostic.IDE0161.severity = none

# ==============================================================================
# Exclusions pour les projets de tests
# ==============================================================================
[tests/**.cs]
# xUnit1030 interdit ConfigureAwait(false) dans les méthodes de test : désactiver MA0004 évite un conflit entre analyseurs
dotnet_diagnostic.MA0004.severity = none
# Une méthode de test Arrange-Act-Assert décrit un scénario complet : la découper en fragments le rendrait illisible
dotnet_diagnostic.MA0051.severity = none
