<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Cadran.Launcher</AssemblyName>
    <RootNamespace>Cadran.Launcher</RootNamespace>
    <ApplicationIcon>cadran.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="cadran.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Locales\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LocaleForge" Version="1.0.0" />
  </ItemGroup>

</Project>
