@page "/"
@model IndexModel
@{
    ViewData["Title"] = Localizer["Landing.WelcomeTitle"];
}

<div class="container py-5">
    <div class="row align-items-center g-5 py-4">
        <div class="col-lg-7">
            <div class="d-flex align-items-center gap-3 mb-3">
                <img src="~/images/cadran-logo-64.png" alt="@Localizer["App.Name"]" width="48" height="48" class="rounded-3 shadow-sm" />
                <span class="badge bg-primary-subtle text-primary px-3 py-2 fw-semibold">
                    <i class="bi bi-shield-check me-1"></i> @Localizer["Landing.HeroBadge"]
                </span>
            </div>

            <h1 class="display-4 fw-bold lh-1 mb-3">
                @Localizer["Landing.HeroHeading"] <span class="text-primary">@Localizer["Landing.HeroHeadingHighlight"]</span>.
            </h1>
            <p class="lead text-muted mb-4">
                @Localizer["Landing.HeroLead"]
            </p>
            <div class="d-flex gap-3">
                <a href="/Security/Register" class="btn btn-primary btn-lg px-4 gap-3">
                    <i class="bi bi-person-plus me-1"></i> @Localizer["Landing.GetStarted"]
                </a>
                <a href="/Security/Login" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> @Localizer["Nav.Login"]
                </a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="row g-3">
                <div class="col-12">
                    <div class="card shadow-sm border-0 p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                                <i class="bi bi-lightning-charge fs-3"></i>
                            </div>
                            <div>
                                <h3 class="h6 fw-bold mb-1">@Localizer["Landing.FeatureRulesTitle"]</h3>
                                <p class="small text-muted mb-0">@Localizer["Landing.FeatureRulesDesc"]</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card shadow-sm border-0 p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                                <i class="bi bi-shield-lock fs-3"></i>
                            </div>
                            <div>
                                <h3 class="h6 fw-bold mb-1">@Localizer["Landing.FeatureSecurityTitle"]</h3>
                                <p class="small text-muted mb-0">@Localizer["Landing.FeatureSecurityDesc"]</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card shadow-sm border-0 p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                                <i class="bi bi-file-earmark-spreadsheet fs-3"></i>
                            </div>
                            <div>
                                <h3 class="h6 fw-bold mb-1">@Localizer["Landing.FeatureImportsTitle"]</h3>
                                <p class="small text-muted mb-0">@Localizer["Landing.FeatureImportsDesc"]</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
