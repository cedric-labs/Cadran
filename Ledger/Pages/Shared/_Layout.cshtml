@using Microsoft.AspNetCore.Identity
@using Ledger.Features.Security.Models
@using Ledger.Features.Settings.Services
@using Ledger.Infrastructure.Configuration
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IUiSettingsService UiSettingsService
@inject ILanguageService LanguageService
@inject Ledger.Features.Security.Context.IDatabaseKeyHolder KeyHolder
@{
    var isDbAccessible = !KeyHolder.IsDatabaseEncrypted || KeyHolder.IsUnlocked;
    var currentFont = isDbAccessible ? await UiSettingsService.GetActiveFontAsync() : null;
    var currentFontSize = isDbAccessible ? await UiSettingsService.GetFontSizeAsync() : "14px";
}

<!DOCTYPE html>
<html lang="fr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["App.Name"]</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/images/cadran-logo-64.png" />

    <!-- Bootstrap 5.3 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bibliothèque d'icônes locale : Bootstrap Icons 1.11.3 (hébergée en local, hors-ligne) -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />

    <!-- Polices typographiques locales (Inter, Roboto, Open Sans, etc. hébergées en local, hors-ligne) -->
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />

    <!-- Police d'écriture dynamique personnalisée (si configurée avec une URL distante) -->
    @if (!string.IsNullOrEmpty(currentFont?.GoogleFontUrl))
    {
        <link rel="stylesheet" href="@currentFont.GoogleFontUrl" />
    }

    <!-- Styles applicatifs -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/@(typeof(Program).Assembly.GetName().Name).styles.css" asp-append-version="true" />

    <style>
        :root {
            --bs-primary: #3b82f6;
            --bs-primary-rgb: 59, 130, 246;
            --app-font-family: @Html.Raw(currentFont?.FontFamilyCss ?? "system-ui, -apple-system, sans-serif");
            --app-font-size: @(currentFontSize ?? "14px");
        }
        body {
            background-color: #f8fafc;
            color: #1e293b;
            font-family: var(--app-font-family);
            font-size: var(--app-font-size);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .nav-link {
            font-weight: 500;
            font-size: 0.95rem;
            border-radius: 0.375rem;
            padding: 0.4rem 0.75rem !important;
            transition: all 0.15s ease-in-out;
        }
        .nav-link:hover {
            background-color: rgba(59, 130, 246, 0.08);
            color: #2563eb !important;
        }
        .card {
            border-radius: 0.75rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.06), 0 1px 2px 0 rgba(0, 0, 0, 0.04);
            border: 1px solid #e2e8f0;
        }
        .card:hover {
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -1px rgba(0, 0, 0, 0.04);
        }
        footer {
            margin-top: auto;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand text-primary d-flex align-items-center gap-2 flex-nowrap text-nowrap" href="/Accounts">
                    <img src="~/images/cadran-logo-32.png" alt="@Localizer["App.Name"]" width="32" height="32" class="rounded-2 shadow-sm" />
                    <span class="text-nowrap">@Localizer["App.Name"]</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    @if (isDbAccessible && SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Accounts">
                                    <i class="bi bi-grid-1x2-fill me-1 text-primary"></i> @Localizer["Nav.Accounts"]
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Transactions">
                                    <i class="bi bi-receipt-cutoff me-1 text-primary"></i> @Localizer["Nav.Transactions"]
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Categories">
                                    <i class="bi bi-tags-fill me-1 text-primary"></i> @Localizer["Nav.Categories"]
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Recurring">
                                    <i class="bi bi-arrow-repeat me-1 text-primary"></i> @Localizer["Nav.Recurring"]
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Reports">
                                    <i class="bi bi-pie-chart-fill me-1 text-primary"></i> @Localizer["Nav.Reports"]
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/RulesEngine">
                                    <i class="bi bi-lightning-charge-fill me-1 text-primary"></i> @Localizer["Nav.Rules"]
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Imports">
                                    <i class="bi bi-cloud-arrow-up-fill me-1 text-primary"></i> @Localizer["Nav.Imports"]
                                </a>
                            </li>
                        </ul>

                        <ul class="navbar-nav ms-auto align-items-center gap-2">
                            <!-- Sélecteur de langue universel (disponible connecté ou non) -->
                            @{
                                var currentLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
                                var returnUrl = Context.Request.Path + Context.Request.QueryString;
                                var availableLanguages = LanguageService.GetSupportedLanguages();
                            }
                            <li class="nav-item dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1 py-1 px-2 border-0" 
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Localizer["Common.Language"]">
                                    <i class="bi bi-translate text-primary"></i>
                                    <span class="small fw-semibold text-uppercase">@currentLang</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-1" style="min-width: 140px; font-size: 0.85rem;">
                                    @foreach (var lang in availableLanguages)
                                    {
                                        var isSelected = lang.Code == currentLang;
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center justify-content-between @(isSelected ? "active fw-bold" : "")" 
                                               href="/SetLanguage?culture=@lang.Code&returnUrl=@Uri.EscapeDataString(returnUrl)">
                                                <span>@lang.DisplayName</span>
                                                @if (isSelected) { <i class="bi bi-check2"></i> }
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <span class="fw-semibold small">@User.Identity?.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item small" href="/Security/EnableMfa">
                                            <i class="bi bi-shield-lock me-2 text-primary"></i> @Localizer["Nav.Security"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item small" href="/Security/DatabaseEncryption">
                                            <i class="bi bi-safe2 me-2 text-primary"></i> @Localizer["Nav.DatabaseEncryption"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item small" href="/Imports/CsvProfiles">
                                            <i class="bi bi-sliders me-2 text-primary"></i> @Localizer["Nav.CsvProfiles"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item small" href="/Accounts/Types">
                                            <i class="bi bi-wallet-fill me-2 text-primary"></i> @Localizer["Nav.AccountTypes"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item small" href="/Accounts/Statuses">
                                            <i class="bi bi-tags me-2 text-primary"></i> @Localizer["Nav.Statuses"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item small" href="/Merchants">
                                            <i class="bi bi-shop me-2 text-primary"></i> @Localizer["Nav.Merchants"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item small" href="/Settings/Appearance">
                                            <i class="bi bi-palette me-2 text-primary"></i> @Localizer["Nav.Appearance"]
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="/Security/Logout">
                                            <button type="submit" class="dropdown-item small text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> @Localizer["Nav.Logout"]
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto align-items-center gap-2">
                            <!-- Sélecteur de langue pour visiteur / pré-connexion -->
                            @{
                                var currentLangAnon = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
                                var returnUrlAnon = Context.Request.Path + Context.Request.QueryString;
                                var availableLanguagesAnon = LanguageService.GetSupportedLanguages();
                            }
                            <li class="nav-item dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1 py-1 px-2 border-0" 
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Localizer["Common.Language"]">
                                    <i class="bi bi-translate text-primary"></i>
                                    <span class="small fw-semibold text-uppercase">@currentLangAnon</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-1" style="min-width: 140px; font-size: 0.85rem;">
                                    @foreach (var lang in availableLanguagesAnon)
                                    {
                                        var isSelected = lang.Code == currentLangAnon;
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center justify-content-between @(isSelected ? "active fw-bold" : "")" 
                                               href="/SetLanguage?culture=@lang.Code&returnUrl=@Uri.EscapeDataString(returnUrlAnon)">
                                                <span>@lang.DisplayName</span>
                                                @if (isSelected) { <i class="bi bi-check2"></i> }
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>

                            @if (KeyHolder.IsUnlocked)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/Security/Login">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> @Localizer["Nav.Login"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-primary btn-sm px-3" href="/Security/Register">
                                        <i class="bi bi-person-plus me-1"></i> @Localizer["Nav.Register"]
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <footer class="border-top py-3 bg-white text-muted small">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <div>
                &copy; @DateTime.UtcNow.Year - <strong>@Localizer["App.Name"]</strong> - @Localizer["App.Tagline"]
            </div>
            <div>
                <span class="badge bg-light text-muted border">
                    <i class="bi bi-shield-check text-success me-1"></i> Données isolées & persistées en local
                </span>
            </div>
        </div>
    </footer>

    <!-- Scripts Bootstrap 5.3 & jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
