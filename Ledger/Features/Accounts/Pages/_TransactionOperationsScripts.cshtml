        function submitQuickRule(event) {
            event.preventDefault();
            var name = document.getElementById('qrRuleName').value.trim();
            var catId = document.getElementById('qrTargetCategoryId').value;
            var keyword = document.getElementById('qrKeyword').value.trim();
            var matchType = document.getElementById('qrMatchType').value;
            var pattern = convertKeywordToRegex(keyword, matchType);

            if (!name) {
                alert('Veuillez renseigner un nom pour la règle.');
                return;
            }
            if (!keyword) {
                alert('Veuillez renseigner au moins un mot-clé ou texte recherché.');
                return;
            }
            if (!catId) {
                alert('Veuillez sélectionner la catégorie à assigner.');
                return;
            }

            var btn = document.getElementById('btnSubmitQuickRule');
            var originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Création...';

            var qrMerchantVal = document.getElementById('qrTargetMerchantId') ? document.getElementById('qrTargetMerchantId').value : null;
            var qrNewMerchant = document.getElementById('qrNewMerchantName') ? document.getElementById('qrNewMerchantName').value : null;
            var payload = {
                Name: name,
                Pattern: pattern,
                TargetCategoryId: catId,
                TargetMerchantId: qrMerchantVal || null,
                NewMerchantName: qrNewMerchant || null,
                TargetBankAccountId: document.getElementById('qrTargetBankAccountId').value || null,
                Priority: parseInt(document.getElementById('qrPriority').value, 10) || 10,
                ShiftToNextMonth: document.getElementById('qrShiftToNextMonth').checked,
                ApplyImmediately: document.getElementById('qrApplyImmediately').checked,
                OverwriteExisting: document.getElementById('qrOverwriteExisting').checked
            };

            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            fetch(window.location.pathname + '?handler=CreateRuleFromTransaction', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            })
            .then(function(res) {
                if (!res.ok) throw new Error('Erreur HTTP ' + res.status);
                return res.json();
            })
            .then(function(data) {
                btn.disabled = false;
                btn.innerHTML = originalText;
                if (data.success) {
                    if (bsQuickRuleModalInstance) bsQuickRuleModalInstance.hide();
                    var msg = 'Règle "' + data.ruleName + '" créée avec succès !';
                    if (data.appliedCount > 0) {
                        msg += '\n' + data.appliedCount + ' opération(s) ont été automatiquement catégorisée(s). La page va se recharger.';
                        alert(msg);
                        window.location.reload();
                    } else {
                        msg += '\nAucune opération supplémentaire n\'a été modifiée immédiatement.';
                        alert(msg);
                    }
                } else {
                    alert('Erreur lors de la création de la règle.');
                }
            })
            .catch(function(err) {
                btn.disabled = false;
                btn.innerHTML = originalText;
                console.error(err);
                alert('Erreur de communication lors de la création de la règle.');
            });
        }

