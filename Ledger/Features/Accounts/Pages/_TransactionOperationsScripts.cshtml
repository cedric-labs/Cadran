        function convertKeywordToRegex(keyword, matchType) {
            if (!keyword) return '';
            var escaped = keyword.split(/([*%?])/).map(function(part) {
                if (part === '*' || part === '%') return '.*';
                if (part === '?') return '.';
                return part.replace(/[\\^$.|+()[\]{}]/g, '\\$&');
            }).join('');

            if (matchType === 'startsWith') {
                return '(?i)^' + escaped;
            } else if (matchType === 'endsWith') {
                return '(?i)' + escaped + '$';
            } else if (matchType === 'exact') {
                return '(?i)^' + escaped + '$';
            } else {
                return '(?i)' + escaped;
            }
        }

        function updateQuickRulePattern() {
            var keyword = document.getElementById('qrKeyword').value.trim();
            var matchType = document.getElementById('qrMatchType').value;
            var pattern = convertKeywordToRegex(keyword, matchType);
            var previewEl = document.getElementById('qrPatternPreview');
            if (previewEl) {
                previewEl.textContent = pattern || '(aucun mot-clé)';
            }
            return pattern;
        }

        var qrMerchantCombobox = null;
        function initQrMerchantCombobox() {
            if (qrMerchantCombobox) return qrMerchantCombobox;
            var searchInput = document.getElementById('qrMerchantSearch');
            var idInput = document.getElementById('qrTargetMerchantId');
            var newNameInput = document.getElementById('qrNewMerchantName');
            var listEl = document.getElementById('qrMerchantList');
            var clearBtn = document.getElementById('btnQrClearMerchant');
            var container = document.getElementById('qrMerchantComboboxContainer');

            if (!searchInput || !idInput || !newNameInput || !listEl) return null;

            function renderList(filterTerm) {
                var term = (filterTerm || '').trim().toLowerCase();
                var matches = availableMerchants.filter(function (m) {
                    return !term || m.name.toLowerCase().indexOf(term) !== -1;
                });
                var exactMatch = availableMerchants.some(function (m) {
                    return m.name.toLowerCase() === term;
                });

                var html = '';
                if (term && !exactMatch) {
                    var safeTerm = filterTerm.trim().replace(/"/g, '&quot;').replace(/'/g, '&#39;');
                    html += '<button type="button" class="dropdown-item text-primary fw-semibold py-1 bg-primary-subtle border-bottom mb-1 btn-create-merchant-item" data-name="' + safeTerm + '">'
                          + '<i class="bi bi-plus-circle me-1"></i> Créer « ' + filterTerm.trim() + ' »'
                          + '</button>';
                }

                matches.slice(0, 30).forEach(function (m) {
                    var safeName = m.name.replace(/"/g, '&quot;').replace(/'/g, '&#39;');
                    html += '<button type="button" class="dropdown-item d-flex align-items-center justify-content-between py-1 btn-select-merchant-item" data-id="' + m.id + '" data-name="' + safeName + '" data-cat-id="' + (m.defaultCategoryId || '') + '">'
                          + '<span class="fw-semibold text-truncate">' + m.name + '</span>'
                          + '<i class="bi bi-chevron-right text-muted small" style="font-size: 0.7rem;"></i>'
                          + '</button>';
                });

                if (!html) {
                    html = '<div class="p-2 text-muted small text-center">Aucun tiers trouvé</div>';
                }

                listEl.innerHTML = html;
                listEl.style.display = 'block';

                listEl.querySelectorAll('.btn-create-merchant-item').forEach(function (btn) {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        var name = this.getAttribute('data-name');
                        idInput.value = '';
                        newNameInput.value = name;
                        searchInput.value = name;
                        hideList();
                    });
                });

                listEl.querySelectorAll('.btn-select-merchant-item').forEach(function (btn) {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        var id = this.getAttribute('data-id');
                        var name = this.getAttribute('data-name');
                        var catId = this.getAttribute('data-cat-id');
                        idInput.value = id;
                        newNameInput.value = '';
                        searchInput.value = name;
                        hideList();
                        if (catId && !document.getElementById('qrTargetCategoryId').value) {
                            document.getElementById('qrTargetCategoryId').value = catId;
                        }
                    });
                });
            }

            function hideList() {
                listEl.style.display = 'none';
            }

            searchInput.addEventListener('input', function () {
                var val = this.value.trim();
                var exact = availableMerchants.find(function (m) {
                    return m.name.toLowerCase() === val.toLowerCase();
                });
                if (exact) {
                    idInput.value = exact.id;
                    newNameInput.value = '';
                } else if (val) {
                    idInput.value = '';
                    newNameInput.value = val;
                } else {
                    idInput.value = '';
                    newNameInput.value = '';
                }
                renderList(this.value);
            });

            searchInput.addEventListener('focus', function () {
                renderList(this.value);
            });

            if (clearBtn) {
                clearBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    idInput.value = '';
                    newNameInput.value = '';
                    searchInput.value = '';
                    hideList();
                });
            }

            document.addEventListener('click', function (e) {
                if (container && !container.contains(e.target)) {
                    hideList();
                }
            });

            qrMerchantCombobox = {
                setValue: function (id, name) {
                    idInput.value = id || '';
                    newNameInput.value = '';
                    searchInput.value = name || '';
                    hideList();
                },
                clear: function () {
                    idInput.value = '';
                    newNameInput.value = '';
                    searchInput.value = '';
                    hideList();
                }
            };
            return qrMerchantCombobox;
        }

