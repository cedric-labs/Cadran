@model Ledger.Features.Accounts.Pages.TransactionOperationsPageModelBase

    <style>
        .cursor-pointer { cursor: pointer; }
        .tree-node-header:hover, .tree-child-item:hover, .tree-item:hover {
            background-color: #f1f5f9;
        }
        .tree-selected {
            background-color: #e0e7ff !important;
            font-weight: 600;
            border-left: 3px solid #6366f1 !important;
        }
        .tree-toggle {
            cursor: pointer;
            padding: 2px 4px;
        }
        .table-comfort .tx-details-panel { display: block !important; }
        .table-comfort .tx-detail-btn { display: none !important; }
        .tx-detail-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 17px;
            height: 17px;
            border-radius: 50%;
            background-color: #f1f5f9;
            color: #64748b;
            border: 1px solid #cbd5e1;
            padding: 0;
            font-size: 0.6rem;
            cursor: pointer;
            line-height: 1;
            transition: all 0.15s ease-in-out;
        }
        .tx-detail-btn:hover {
            background-color: #e2e8f0;
            color: #1e293b;
            border-color: #94a3b8;
        }
        .tx-detail-btn.active {
            background-color: #e0e7ff;
            color: #4338ca;
            border-color: #a5b4fc;
        }
        .status-pill-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 1px 7px;
            font-size: 0.7rem;
            font-weight: 500;
            line-height: 1.25;
            border-radius: 9999px;
            border: 1px solid;
            cursor: pointer;
            background: transparent;
            white-space: nowrap;
            transition: all 0.15s ease-in-out;
        }
        .status-pill-badge:hover {
            filter: brightness(0.92);
        }
        .col-draggable {
            cursor: grab;
            user-select: none;
            position: relative;
        }
        .col-draggable:active {
            cursor: grabbing;
        }
        .col-dragging {
            opacity: 0.4;
            background-color: #e2e8f0 !important;
        }
        .col-drag-over-left {
            border-left: 3px solid #3b82f6 !important;
        }
        .col-drag-over-right {
            border-right: 3px solid #3b82f6 !important;
        }
    </style>
    <script src="~/js/table-columns.js" asp-append-version="true"></script>
    <script>
        var bsModalInstance = null;

        function toggleTreeNode(parentId) {
            var children = document.getElementById('children-' + parentId);
            var chevron = document.getElementById('chevron-' + parentId);
            if (children.style.display === 'none') {
                children.style.display = 'block';
                chevron.className = 'bi bi-chevron-down';
            } else {
                children.style.display = 'none';
                chevron.className = 'bi bi-chevron-right';
            }
        }

        var modalCurrentTxType = 'Debit';

        function selectCategoryNode(catId, catName, icon, color, isIncome) {
            document.getElementById('modalNewCategoryId').value = catId;

            // Retirer la classe sélectionnée précédente
            document.querySelectorAll('.tree-selected').forEach(function(el) {
                el.classList.remove('tree-selected');
            });

            // Ajouter la classe à l'élément cliqué
            var selectedItem = catId ? document.getElementById('tree-item-' + catId) : document.getElementById('tree-item-none');
            if (selectedItem) {
                selectedItem.classList.add('tree-selected');
            }

            // Mettre à jour l'aperçu
            var preview = document.getElementById('modalSelectedCategoryPreview');
            if (catId) {
                preview.innerHTML = '<span class="badge rounded-pill border" style="background-color: ' + color + '20; color: ' + color + '; border-color: ' + color + '40 !important;"><i class="bi ' + icon + ' me-1"></i> ' + catName + '</span>';
            } else {
                preview.innerHTML = '<span class="badge bg-light text-muted border"><i class="bi bi-tag me-1"></i> Non catégorisé</span>';
            }

            // Alerte en cas d'incohérence flux/catégorie
            var alertEl = document.getElementById('modalCategoryAnomalyAlert');
            if (alertEl) {
                if (isIncome !== null && isIncome !== undefined && modalCurrentTxType) {
                    var isAnomaly = (modalCurrentTxType === 'Debit' && isIncome === true) ||
                                    (modalCurrentTxType === 'Credit' && isIncome === false);
                    if (isAnomaly) {
                        alertEl.classList.remove('d-none');
                        alertEl.classList.add('d-flex');
                    } else {
                        alertEl.classList.remove('d-flex');
                        alertEl.classList.add('d-none');
                    }
                } else {
                    alertEl.classList.remove('d-flex');
                    alertEl.classList.add('d-none');
                }
            }
        }

        function filterCategoryTree(term) {
            var search = (term || '').trim().toLowerCase();
            var nodes = document.querySelectorAll('#categoryTreeContainer .tree-node');

            nodes.forEach(function(node) {
                var parentName = node.getAttribute('data-cat-name') || '';
                var children = node.querySelectorAll('.tree-child-item');
                var matchCount = 0;

                children.forEach(function(child) {
                    var childName = child.getAttribute('data-cat-name') || '';
                    if (!search || childName.indexOf(search) !== -1 || parentName.indexOf(search) !== -1) {
                        child.style.display = 'flex';
                        matchCount++;
                    } else {
                        child.style.display = 'none';
                    }
                });

                var parentMatches = parentName.indexOf(search) !== -1;
                if (!search || parentMatches || matchCount > 0) {
                    node.style.display = 'block';
                    // Déplier automatiquement si recherche active
                    if (search) {
                        var childContainer = node.querySelector('.tree-children');
                        var chevron = node.querySelector('.bi-chevron-right, .bi-chevron-down');
                        if (childContainer) childContainer.style.display = 'block';
                        if (chevron) chevron.className = 'bi bi-chevron-down';
                    }
                } else {
                    node.style.display = 'none';
                }
            });
        }

        var modalCurrentTxDate = '';

        function updateModalBudgetDateBadge() {
            var bInput = document.getElementById('modalBudgetDateInput');
            var badge = document.getElementById('modalBudgetDateBadge');
            if (!bInput || !badge) return;
            if (modalCurrentTxDate && bInput.value) {
                var txMonth = modalCurrentTxDate.substring(0, 7);
                var bMonth = bInput.value.substring(0, 7);
                if (txMonth !== bMonth) {
                    badge.className = 'badge bg-primary text-white';
                    badge.textContent = 'Décalé sur ' + bMonth;
                    return;
                }
            }
            badge.className = 'badge bg-secondary-subtle text-secondary';
            badge.textContent = 'Date réelle';
        }

        var btnShift = document.getElementById('btnModalShiftNextMonth');
        if (btnShift) {
            btnShift.addEventListener('click', function () {
                if (!modalCurrentTxDate) return;
                var parts = modalCurrentTxDate.split('-');
                var y = parseInt(parts[0], 10);
                var m = parseInt(parts[1], 10);
                m++;
                if (m > 12) {
                    m = 1;
                    y++;
                }
                var nextMonthStr = y + '-' + String(m).padStart(2, '0') + '-01';
                var bInput = document.getElementById('modalBudgetDateInput');
                if (bInput) {
                    bInput.value = nextMonthStr;
                    updateModalBudgetDateBadge();
                }
            });
        }

        var btnReset = document.getElementById('btnModalResetBudgetDate');
        if (btnReset) {
            btnReset.addEventListener('click', function () {
                if (!modalCurrentTxDate) return;
                var bInput = document.getElementById('modalBudgetDateInput');
                if (bInput) {
                    bInput.value = modalCurrentTxDate;
                    updateModalBudgetDateBadge();
                }
            });
        }

        var bInputEl = document.getElementById('modalBudgetDateInput');
        if (bInputEl) {
            bInputEl.addEventListener('change', updateModalBudgetDateBadge);
        }

        var availableMerchants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableMerchants.Select(m => new { id = m.Id.ToString(), name = m.Name, defaultCategoryId = m.DefaultCategoryId?.ToString() })));

        function renderMerchantList(filterTerm) {
            var listEl = document.getElementById('modalMerchantList');
            if (!listEl) return;
            var term = (filterTerm || '').trim().toLowerCase();
            var matches = availableMerchants.filter(function(m) {
                return !term || m.name.toLowerCase().indexOf(term) !== -1;
            });

            var exactMatch = availableMerchants.some(function(m) {
                return m.name.toLowerCase() === term;
            });

            var html = '';
            matches.slice(0, 30).forEach(function(m) {
                var safeName = m.name.replace(/"/g, '&quot;');
                html += '<button type="button" class="dropdown-item d-flex align-items-center justify-content-between py-1" onclick="selectMerchant(\'' + m.id + '\', \'' + safeName + '\', \'' + (m.defaultCategoryId || '') + '\')">'
                     + '<span class="fw-semibold text-truncate">' + m.name + '</span>'
                     + '<i class="bi bi-chevron-right text-muted small" style="font-size: 0.7rem;"></i>'
                     + '</button>';
            });

            if (term && !exactMatch) {
                var safeTerm = filterTerm.trim().replace(/"/g, '&quot;');
                html = '<button type="button" class="dropdown-item text-primary fw-semibold py-1 bg-primary-subtle border-bottom mb-1" onclick="selectNewMerchant(\'' + safeTerm + '\')">'
                     + '<i class="bi bi-plus-circle me-1"></i> Créer « ' + filterTerm.trim() + ' »'
                     + '</button>' + html;
            }

            if (!html) {
                html = '<div class="p-2 text-muted small text-center">Aucun tiers trouvé</div>';
            }

            listEl.innerHTML = html;
            listEl.style.display = 'block';
        }

        function onMerchantSearchInput(val) {
            document.getElementById('modalMerchantId').value = '';
            document.getElementById('modalNewMerchantName').value = val.trim();
            renderMerchantList(val);
        }

        function onMerchantSearchFocus() {
            renderMerchantList(document.getElementById('modalMerchantSearch').value);
        }

        function selectMerchant(id, name, defaultCatId) {
            document.getElementById('modalMerchantId').value = id;
            document.getElementById('modalNewMerchantName').value = '';
            document.getElementById('modalMerchantSearch').value = name;
            hideMerchantDropdown();

            var currentCatVal = document.getElementById('modalNewCategoryId').value;
            if (defaultCatId && (!currentCatVal || currentCatVal === '')) {
                var targetNode = document.getElementById('tree-item-' + defaultCatId);
                if (targetNode) {
                    targetNode.click();
                }
            }
        }

        function selectNewMerchant(name) {
            document.getElementById('modalMerchantId').value = '';
            document.getElementById('modalNewMerchantName').value = name;
            document.getElementById('modalMerchantSearch').value = name;
            hideMerchantDropdown();
        }

        function clearSelectedMerchant() {
            document.getElementById('modalMerchantId').value = '';
            document.getElementById('modalNewMerchantName').value = '';
            document.getElementById('modalMerchantSearch').value = '';
            hideMerchantDropdown();
        }

        function hideMerchantDropdown() {
            var listEl = document.getElementById('modalMerchantList');
            if (listEl) listEl.style.display = 'none';
        }

        document.addEventListener('click', function(e) {
            var container = document.getElementById('merchantComboboxContainer');
            if (container && !container.contains(e.target)) {
                hideMerchantDropdown();
            }
        });

        function openCategoryModal(txId, currentCatId, label, amount, type, txDate, budgetDate, notes) {
            var row = document.getElementById('tx-row-' + txId);
            if (row) {
                currentCatId = row.dataset.catId || currentCatId || '';
                label = row.dataset.label || label || '';
                amount = row.dataset.amount || amount || '';
                type = row.dataset.type || type || 'Debit';
                txDate = row.dataset.date || txDate || '';
                budgetDate = row.dataset.budgetDate || budgetDate || '';
                notes = row.dataset.notes || notes || '';
            }

            document.getElementById('modalTransactionId').value = txId;
            document.getElementById('modalTransactionLabel').textContent = label;
            document.getElementById('modalTransactionAmount').textContent = (type === 'Credit' ? '+' : '-') + amount;
            document.getElementById('modalTransactionAmount').className = 'small fw-semibold mt-1 ' + (type === 'Credit' ? 'text-success' : 'text-dark');
            document.getElementById('modalTransactionNotes').value = notes || '';
            document.getElementById('modalApplySimilar').checked = false;
            document.getElementById('categoryTreeSearch').value = '';
            filterCategoryTree('');

            var merchantId = row ? (row.dataset.merchantId || '') : '';
            var merchantName = row ? (row.dataset.merchantName || '') : '';
            document.getElementById('modalMerchantId').value = merchantId;
            document.getElementById('modalNewMerchantName').value = '';
            document.getElementById('modalMerchantSearch').value = merchantName;
            hideMerchantDropdown();

            modalCurrentTxDate = txDate || '';
            var bInput = document.getElementById('modalBudgetDateInput');
            if (bInput) {
                bInput.value = budgetDate || txDate || '';
                updateModalBudgetDateBadge();
            }

            // Mettre en surbrillance l'élément actuel
            var selectedItem = currentCatId ? document.getElementById('tree-item-' + currentCatId) : document.getElementById('tree-item-none');
            document.querySelectorAll('.tree-selected').forEach(function(el) { el.classList.remove('tree-selected'); });
            if (selectedItem) {
                selectedItem.classList.add('tree-selected');
                selectedItem.scrollIntoView({ block: 'nearest' });
            }

            // Initialiser la valeur dans le champ
            document.getElementById('modalNewCategoryId').value = currentCatId || '';

            modalCurrentTxType = type || 'Debit';

            // Aperçu actuel
            var preview = document.getElementById('modalSelectedCategoryPreview');
            var existingBadge = document.querySelector('.category-pill-' + txId);
            if (existingBadge && currentCatId) {
                preview.innerHTML = existingBadge.outerHTML;
            } else {
                preview.innerHTML = '<span class="badge bg-light text-muted border"><i class="bi bi-tag me-1"></i> Non catégorisé</span>';
            }

            // Vérifier anomalie initiale
            var alertEl = document.getElementById('modalCategoryAnomalyAlert');
            if (alertEl) {
                if (selectedItem && selectedItem.getAttribute('data-is-income') !== null && selectedItem.getAttribute('data-is-income') !== '') {
                    var isIncome = selectedItem.getAttribute('data-is-income') === 'true';
                    var isAnomaly = (modalCurrentTxType === 'Debit' && isIncome) || (modalCurrentTxType === 'Credit' && !isIncome);
                    if (isAnomaly) {
                        alertEl.classList.remove('d-none');
                        alertEl.classList.add('d-flex');
                    } else {
                        alertEl.classList.remove('d-flex');
                        alertEl.classList.add('d-none');
                    }
                } else {
                    alertEl.classList.remove('d-flex');
                    alertEl.classList.add('d-none');
                }
            }

            var statusSelect = document.getElementById('modalTransactionStatus');
            if (statusSelect) {
                statusSelect.value = (row ? row.dataset.statusId : '') || '';
            }

            var modalEl = document.getElementById('categoryModal');
            bsModalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            bsModalInstance.show();
        }

        function applyStatusToRow(txId, statusId, colorHex, iconClass, displayName) {
            var row = document.getElementById('tx-row-' + txId);
            if (row) {
                row.dataset.statusId = statusId;
            }
            var btn = document.querySelector('.status-btn-' + txId);
            if (btn) {
                btn.style.backgroundColor = colorHex + '15';
                btn.style.color = colorHex;
                btn.style.borderColor = colorHex + '40';
            }
            var icon = document.querySelector('.status-icon-' + txId);
            if (icon) {
                icon.className = 'bi ' + iconClass + ' status-icon-' + txId;
            }
            var label = document.querySelector('.status-label-' + txId);
            if (label) {
                label.textContent = displayName;
            }
            var dropdownMenu = document.querySelector('#status-dropdown-' + txId + ' .dropdown-menu');
            if (dropdownMenu) {
                dropdownMenu.querySelectorAll('.dropdown-item').forEach(function(item) {
                    item.classList.remove('active', 'fw-bold');
                });
                var activeItem = dropdownMenu.querySelector('.item-status-' + statusId);
                if (activeItem) {
                    activeItem.classList.add('active', 'fw-bold');
                }
            }
        }

        function updateTransactionStatus(txId, statusId) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            var formData = new FormData();
            formData.append('transactionId', txId);
            formData.append('statusId', statusId);

            fetch(window.location.pathname + '?handler=UpdateStatus', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.success) {
                    applyStatusToRow(txId, data.statusId, data.colorHex, data.iconClass, data.displayName);
                } else {
                    alert('Erreur lors du changement de statut.');
                }
            })
            .catch(function(err) {
                console.error(err);
                alert('Erreur de communication lors du changement de statut.');
            });
        }

        function toggleSelectAll(checked) {
            var checkboxes = document.querySelectorAll('.tx-select-check');
            checkboxes.forEach(function(cb) {
                cb.checked = checked;
            });
            updateBulkActionBar();
        }

        function onTransactionSelectChange() {
            var all = document.querySelectorAll('.tx-select-check');
            var checked = document.querySelectorAll('.tx-select-check:checked');
            var selectAll = document.getElementById('selectAllCheckbox');
            if (selectAll) {
                selectAll.checked = (all.length > 0 && all.length === checked.length);
                selectAll.indeterminate = (checked.length > 0 && checked.length < all.length);
            }
            updateBulkActionBar();
        }

        function updateBulkActionBar() {
            var checked = document.querySelectorAll('.tx-select-check:checked');
            var bar = document.getElementById('bulkActionsBar');
            var badge = document.getElementById('selectedCountBadge');
            if (!bar) return;
            if (checked.length > 0) {
                bar.classList.remove('d-none');
                if (badge) badge.textContent = checked.length;
            } else {
                bar.classList.add('d-none');
                if (badge) badge.textContent = '0';
            }
        }

        function clearSelection() {
            var checkboxes = document.querySelectorAll('.tx-select-check');
            checkboxes.forEach(function(cb) { cb.checked = false; });
            var selectAll = document.getElementById('selectAllCheckbox');
            if (selectAll) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
            }
            updateBulkActionBar();
        }

        function applyBulkStatus(statusId) {
            var checked = document.querySelectorAll('.tx-select-check:checked');
            if (checked.length === 0) return;

            var ids = Array.from(checked).map(function(cb) { return cb.value; });
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            var formData = new FormData();
            ids.forEach(function(id) {
                formData.append('transactionIds', id);
            });
            formData.append('statusId', statusId);

            fetch(window.location.pathname + '?handler=BulkUpdateStatus', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.success && data.updatedIds) {
                    data.updatedIds.forEach(function(id) {
                        applyStatusToRow(id, data.statusId, data.colorHex, data.iconClass, data.displayName);
                    });
                    clearSelection();
                } else {
                    alert('Erreur lors de la mise à jour des statuts.');
                }
            })
            .catch(function(err) {
                console.error(err);
                alert('Erreur de communication.');
            });
        }

        var updateCatForm = document.getElementById('updateCategoryForm');
        if (updateCatForm) {
            updateCatForm.addEventListener('submit', function (e) {
                var mSearch = (document.getElementById('modalMerchantSearch')?.value || '').trim();
                var mId = document.getElementById('modalMerchantId')?.value;
                var hiddenNew = document.getElementById('modalNewMerchantName');
            if (!mId && mSearch) {
                var found = availableMerchants.find(function(m) {
                    return m.name.toLowerCase() === mSearch.toLowerCase();
                });
                if (found) {
                    document.getElementById('modalMerchantId').value = found.id;
                    hiddenNew.value = '';
                } else {
                    hiddenNew.value = mSearch;
                }
            } else if (!mSearch) {
                document.getElementById('modalMerchantId').value = '';
                hiddenNew.value = '';
            }

            var applySimilar = document.getElementById('modalApplySimilar').checked;
            if (applySimilar) {
                return;
            }

            e.preventDefault();
            var form = this;
            var formData = new FormData(form);
            var txId = document.getElementById('modalTransactionId').value;
            var submitBtn = document.getElementById('modalSubmitBtn');
            submitBtn.disabled = true;

            fetch(form.action || window.location.pathname + '?handler=UpdateCategory', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.success) {
                    var row = document.getElementById('tx-row-' + txId);
                    if (row) {
                        row.dataset.catId = data.categoryId || '';
                        row.dataset.budgetDate = data.budgetDateStr || '';
                        row.dataset.notes = data.notes || '';
                        row.dataset.merchantId = data.merchantId || '';
                        row.dataset.merchantName = data.merchantName || '';
                    }

                    var mBadge = document.querySelector('.tx-merchant-badge-' + txId);
                    if (mBadge) {
                        if (data.merchantName) {
                            mBadge.classList.remove('d-none');
                            mBadge.innerHTML = '<i class="bi bi-shop me-1"></i>' + data.merchantName;
                        } else {
                            mBadge.classList.add('d-none');
                            mBadge.innerHTML = '';
                        }
                    }

                    if (data.merchantId && !availableMerchants.some(function(m) { return m.id === data.merchantId; })) {
                        availableMerchants.push({ id: data.merchantId, name: data.merchantName, defaultCategoryId: data.categoryId });
                    }

                    var badges = document.querySelectorAll('.category-pill-' + txId);
                    badges.forEach(function(badge) {
                        if (data.categoryId) {
                            badge.className = 'badge rounded-pill border category-pill-' + txId;
                            badge.style.backgroundColor = data.categoryColor + '20';
                            badge.style.color = data.categoryColor;
                            badge.style.borderColor = data.categoryColor + '40';
                            badge.innerHTML = '<i class="bi ' + data.categoryIcon + ' me-1"></i> ' + data.categoryName + ' <i class="bi bi-pencil-fill ms-1 opacity-50" style="font-size: 0.7em;"></i>';
                        } else {
                            badge.className = 'badge bg-light text-muted border category-pill-' + txId;
                            badge.style = 'cursor: pointer;';
                            badge.innerHTML = '<i class="bi bi-tag me-1"></i> Non catégorisé <i class="bi bi-pencil-fill ms-1 opacity-50" style="font-size: 0.7em;"></i>';
                        }
                    });

                    // Mise à jour du statut
                    if (data.statusId) {
                        applyStatusToRow(txId, data.statusId, data.statusColorHex, data.statusIconClass, data.statusDisplayName);
                    }

                    // Mise à jour du badge budgétaire
                    var budgetBadge = document.getElementById('budget-badge-' + txId);
                    if (budgetBadge) {
                        if (data.isShifted && data.budgetBadgeText) {
                            budgetBadge.innerHTML = '<span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.65rem;" title="Comptabilisé sur le budget de ' + data.budgetBadgeText + '"><i class="bi bi-calendar-event me-1"></i> Budget ' + data.budgetBadgeText + '</span>';
                        } else {
                            budgetBadge.innerHTML = '';
                        }
                    }

                    // Mise à jour de la note
                    var notesBadge = document.getElementById('notes-badge-' + txId);
                    if (notesBadge) {
                        if (data.notes && data.notes.trim()) {
                            var escDiv = document.createElement('div');
                            escDiv.textContent = data.notes;
                            notesBadge.innerHTML = '<div class="small text-dark bg-warning-subtle border border-warning-subtle rounded px-2 py-1 d-inline-flex align-items-center gap-1 cursor-pointer" onclick="openCategoryModal(\'' + txId + '\')" title="Cliquer pour modifier la note" style="font-size: 0.78rem;"><i class="bi bi-sticky-fill text-warning"></i><span class="note-text">' + escDiv.innerHTML + '</span></div>';
                        } else {
                            notesBadge.innerHTML = '';
                        }
                    }

                    if (bsModalInstance) {
                        bsModalInstance.hide();
                    }
                } else {
                    form.submit();
                }
            })
            .catch(function(err) {
                form.submit();
            })
            .finally(function() {
                submitBtn.disabled = false;
            });
        });
        }

        // Gestion de la liste déroulante de filtre de période
        const periodSelect = document.getElementById('periodSelect');
        if (periodSelect) {
            periodSelect.addEventListener('change', function () {
                const period = this.value;
                const form = document.getElementById('filterForm');
                const startInput = document.getElementById('startDateInput');
                const endInput = document.getElementById('endDateInput');

                const now = new Date();
                const formatDate = (d) => {
                    const year = d.getFullYear();
                    const month = String(d.getMonth() + 1).padStart(2, '0');
                    const day = String(d.getDate()).padStart(2, '0');
                    return `${year}-${month}-${day}`;
                };

                if (period === 'all') {
                    if (startInput) startInput.value = '';
                    if (endInput) endInput.value = '';
                } else if (period === 'current-month') {
                    const start = new Date(now.getFullYear(), now.getMonth(), 1);
                    const end = new Date(now.getFullYear(), now.getMonth() + 1, 0);
                    if (startInput) startInput.value = formatDate(start);
                    if (endInput) endInput.value = formatDate(end);
                } else if (period === 'two-weeks') {
                    const start = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 14);
                    if (startInput) startInput.value = formatDate(start);
                    if (endInput) endInput.value = formatDate(now);
                } else if (period === 'last-month') {
                    const start = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                    const end = new Date(now.getFullYear(), now.getMonth(), 0);
                    if (startInput) startInput.value = formatDate(start);
                    if (endInput) endInput.value = formatDate(end);
                } else if (period === 'three-months') {
                    const start = new Date(now.getFullYear(), now.getMonth() - 3, now.getDate());
                    if (startInput) startInput.value = formatDate(start);
                    if (endInput) endInput.value = formatDate(now);
                } else if (period === 'six-months') {
                    const start = new Date(now.getFullYear(), now.getMonth() - 6, now.getDate());
                    if (startInput) startInput.value = formatDate(start);
                    if (endInput) endInput.value = formatDate(now);
                }

                if (period !== 'custom') {
                    if (form) form.submit();
                }
            });
        }

