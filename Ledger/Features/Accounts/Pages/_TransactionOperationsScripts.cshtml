            foreach (var parent in Model.ParentCategories)
            {
                var parentName = Model.CategoryTranslations.TryGetValue(parent.Id, out var pEn) && !string.IsNullOrWhiteSpace(pEn) ? pEn : parent.Name;
                sbCatOptions.Append($"<optgroup label=\"{System.Net.WebUtility.HtmlEncode(parentName)}\">");
                sbCatOptions.Append($"<option value=\"{parent.Id}\">▶ {System.Net.WebUtility.HtmlEncode(parentName)}</option>");
                foreach (var sub in parent.SubCategories.OrderBy(s => s.Name))
                {
                    var subName = Model.CategoryTranslations.TryGetValue(sub.Id, out var sEn) && !string.IsNullOrWhiteSpace(sEn) ? sEn : sub.Name;
                    sbCatOptions.Append($"<option value=\"{sub.Id}\">&nbsp;&nbsp;&nbsp;• {System.Net.WebUtility.HtmlEncode(subName)}</option>");
                }
                sbCatOptions.Append("</optgroup>");
            }
            var splitCategoriesHtmlStr = sbCatOptions.ToString();
        }

        var splitCategoryOptionsHtml = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(splitCategoriesHtmlStr));

        var splitMerchantOptionsHtml = '<option value="">-- @Localizer["Merchants.NoMerchant"] --</option>' +
            availableMerchants.map(function(m) {
                return '<option value="' + m.id + '">' + m.name.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</option>';
            }).join('');

        var bsSplitModalInstance = null;
        var currentSplitTotalAmount = 0;
        var currentSplitTxId = null;
        var splitCurrencySymbol = '€';

        function formatSplitCurrency(amount) {
            return (amount || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + splitCurrencySymbol;
        }

        function openSplitModal(txId) {
            currentSplitTxId = txId;
            document.getElementById('splitModalTxId').value = txId;
            var container = document.getElementById('splitLinesContainer');
            container.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted"><span class="spinner-border spinner-border-sm me-1"></span> Chargement...</td></tr>';

            var modalEl = document.getElementById('splitTransactionModal');
            bsSplitModalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            bsSplitModalInstance.show();

            var baseUrl = window.location.pathname;
            fetch(baseUrl + '?handler=TransactionSplits&transactionId=' + encodeURIComponent(txId), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(res) {
                if (!res.ok) throw new Error('Erreur HTTP ' + res.status);
                return res.json();
            })
            .then(function(data) {
                if (!data.success) {
                    alert(data.message || 'Erreur lors du chargement de l\'opération.');
                    bsSplitModalInstance.hide();
                    return;
                }

                currentSplitTotalAmount = data.totalAmount;
                if (data.currencySymbol) splitCurrencySymbol = data.currencySymbol;
                var thCur = document.getElementById('splitModalThCurrency');
                if (thCur) thCur.textContent = splitCurrencySymbol;

                document.getElementById('splitModalTxLabel').textContent = data.label;
                document.getElementById('splitModalTxDate').textContent = data.date ? data.date.substring(0, 10) : '';
                var typeSign = (data.type === 1 || data.type === 'Credit' ? '+' : '-');
                document.getElementById('splitModalTxTotalAmount').textContent = typeSign + formatSplitCurrency(data.totalAmount);
                document.getElementById('splitModalTxTotalAmount').className = 'fs-5 fw-bold ' + (data.type === 1 || data.type === 'Credit' ? 'text-success' : 'text-dark');

                var btnDelete = document.getElementById('btnDeleteSplits');
                if (btnDelete) {
                    btnDelete.style.display = data.isSplit ? 'inline-block' : 'none';
                }

                container.innerHTML = '';
                if (data.splits && data.splits.length > 0) {
                    data.splits.forEach(function(s) {
                        addSplitLine(s.amount, s.categoryId, s.merchantId, s.notes);
                    });
                } else {
                    var half1 = Math.round((data.totalAmount / 2) * 100) / 100;
                    var half2 = Math.round((data.totalAmount - half1) * 100) / 100;
                    var row = document.getElementById('tx-row-' + txId);
                    var initialCatId = row ? (row.dataset.catId || '') : '';
                    var initialMerchId = row ? (row.dataset.merchantId || '') : '';
                    addSplitLine(half1, initialCatId, initialMerchId, '');
                    addSplitLine(half2, '', '', '');
                }

                recalculateSplitBalance();
            })
            .catch(function(err) {
                console.error(err);
                alert('Erreur lors du chargement des informations de l\'opération.');
                bsSplitModalInstance.hide();
            });
        }

        var strSplitRemove = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Transactions.SplitRemove"].Value));

        function addSplitLine(amount, categoryId, merchantId, notes) {
            var container = document.getElementById('splitLinesContainer');
            var tr = document.createElement('tr');
            tr.className = 'split-line-row';

            var valAmount = amount !== undefined && amount !== null ? parseFloat(amount).toFixed(2) : '';
            var valNotes = notes ? notes.replace(/"/g, '&quot;') : '';

            tr.innerHTML = '<td>' +
                '<input type="number" step="0.01" min="0.01" class="form-control form-control-sm split-line-amount text-end fw-semibold" value="' + valAmount + '" oninput="recalculateSplitBalance()" placeholder="0.00" required />' +
                '</td>' +
                '<td>' +
                '<select class="form-select form-select-sm split-line-category">' + splitCategoryOptionsHtml + '</select>' +
                '</td>' +
                '<td>' +
                '<select class="form-select form-select-sm split-line-merchant">' + splitMerchantOptionsHtml + '</select>' +
                '</td>' +
                '<td>' +
                '<input type="text" class="form-control form-control-sm split-line-notes" placeholder="Note (optionnelle)..." value="' + valNotes + '" />' +
                '</td>' +
                '<td class="text-center">' +
                '<button type="button" class="btn btn-outline-danger btn-sm p-1" onclick="removeSplitLine(this)" title="' + strSplitRemove + '">' +
                '<i class="bi bi-trash"></i>' +
                '</button>' +
                '</td>';

            container.appendChild(tr);

            if (categoryId) {
                tr.querySelector('.split-line-category').value = categoryId;
            }
            if (merchantId) {
                tr.querySelector('.split-line-merchant').value = merchantId;
            }

            recalculateSplitBalance();
        }

        function removeSplitLine(btn) {
            var rows = document.querySelectorAll('.split-line-row');
            if (rows.length <= 2) {
                alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Transactions.SplitMinPartsError"].Value)));
                return;
            }
            btn.closest('tr').remove();
            recalculateSplitBalance();
        }

        function recalculateSplitBalance() {
            var rows = document.querySelectorAll('.split-line-row');
            var allocated = 0;
            rows.forEach(function(row) {
                var amtInput = row.querySelector('.split-line-amount');
                var val = parseFloat(amtInput?.value) || 0;
                allocated += val;
            });

            allocated = Math.round(allocated * 100) / 100;
            var remaining = Math.round((currentSplitTotalAmount - allocated) * 100) / 100;

            var allocEl = document.getElementById('splitModalAllocatedAmount');
            if (allocEl) allocEl.textContent = formatSplitCurrency(allocated);

            var remBadge = document.getElementById('splitModalRemainingBadge');
            var alertEl = document.getElementById('splitBalanceAlert');
            var saveBtn = document.getElementById('btnSaveSplits');

            var isBalanced = Math.abs(remaining) < 0.005 && rows.length >= 2;

            if (remBadge) {
                if (Math.abs(remaining) < 0.005) {
                    remBadge.className = 'badge bg-success text-white px-2 py-1 fs-6';
                    remBadge.textContent = '0,00 ' + splitCurrencySymbol + ' (Équilibré)';
                } else if (remaining > 0) {
                    remBadge.className = 'badge bg-warning text-dark px-2 py-1 fs-6';
                    remBadge.textContent = '+' + formatSplitCurrency(remaining) + ' restant';
                } else {
                    remBadge.className = 'badge bg-danger text-white px-2 py-1 fs-6';
                    remBadge.textContent = formatSplitCurrency(remaining) + ' (Dépassement)';
                }
            }

            if (alertEl) {
                alertEl.style.display = isBalanced ? 'none' : 'block';
            }

            if (saveBtn) {
                saveBtn.disabled = !isBalanced;
            }
        }

        function saveSplits() {
            var rows = document.querySelectorAll('.split-line-row');
            if (rows.length < 2) {
                alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Transactions.SplitMinPartsError"].Value)));
                return;
            }

            var splits = [];
            var total = 0;
            var hasInvalidAmount = false;

            rows.forEach(function(r) {
                var amt = parseFloat(r.querySelector('.split-line-amount')?.value);
                if (!amt || amt <= 0) {
                    hasInvalidAmount = true;
                }
                var catVal = r.querySelector('.split-line-category')?.value || null;
                var merchVal = r.querySelector('.split-line-merchant')?.value || null;
                var noteVal = r.querySelector('.split-line-notes')?.value?.trim() || null;

                total += amt || 0;
                splits.push({
                    amount: amt,
                    categoryId: catVal ? catVal : null,
                    merchantId: merchVal ? merchVal : null,
                    notes: noteVal
                });
            });

            if (hasInvalidAmount) {
                alert('Toutes les parts doivent avoir un montant strictement supérieur à 0.');
                return;
            }

            total = Math.round(total * 100) / 100;
            if (Math.abs(total - currentSplitTotalAmount) > 0.01) {
                alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Transactions.SplitBalanceError"].Value)));
                return;
            }

            var saveBtn = document.getElementById('btnSaveSplits');
            var origText = saveBtn.innerHTML;
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Enregistrement...';

            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                var baseUrl = window.location.pathname;
                fetch(baseUrl + '?handler=SaveTransactionSplits', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        transactionId: currentSplitTxId,
                        splits: splits
                    })
                })
                .then(function(res) {
                    if (!res.ok) {
                        return res.json().then(function(errData) {
                            throw new Error(errData.message || ('Erreur HTTP ' + res.status));
                        }).catch(function(jsonErr) {
                            if (jsonErr && jsonErr.message && !jsonErr.message.startsWith('Erreur HTTP')) {
                                throw jsonErr;
                            }
                            throw new Error('Erreur HTTP ' + res.status);
                        });
                    }
                    return res.json();
                })
                .then(function(data) {
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = origText;
                    if (data.success) {
                        bsSplitModalInstance.hide();
                        window.location.reload();
                    } else {
                        alert(data.message || 'Erreur lors de l\'enregistrement de la ventilation.');
                    }
                })
                .catch(function(err) {
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = origText;
                    console.error(err);
                    alert(err.message || 'Erreur lors de l\'enregistrement.');
                });
            } catch (err) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = origText;
                console.error(err);
                alert(err.message || 'Erreur lors de l\'enregistrement.');
            }
        }

        function removeSplits() {
            if (!confirm('Voulez-vous vraiment annuler la ventilation et rétablir l\'opération en une seule ligne ?')) {
                return;
            }

            var btnDelete = document.getElementById('btnDeleteSplits');
            btnDelete.disabled = true;

            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            var formData = new FormData();
            formData.append('transactionId', currentSplitTxId);

            var baseUrl = window.location.pathname;
            fetch(baseUrl + '?handler=RemoveTransactionSplits', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(function(res) {
                if (!res.ok) throw new Error('Erreur HTTP ' + res.status);
                return res.json();
            })
            .then(function(data) {
                if (data.success) {
                    bsSplitModalInstance.hide();
                    window.location.reload();
                } else {
                    btnDelete.disabled = false;
                    alert(data.message || 'Erreur lors de la suppression de la ventilation.');
                }
            })
            .catch(function(err) {
                btnDelete.disabled = false;
                console.error(err);
                alert('Erreur lors de la communication avec le serveur.');
            });
        }

        function changePageSize(size) {
            var url = new URL(window.location.href);
            url.searchParams.set('PageSize', size);
            url.searchParams.set('PageNumber', '1');
            window.location.href = url.toString();
        }

        // Initialisation du mode d'affichage et des colonnes personnalisables
        document.addEventListener('DOMContentLoaded', function() {
            var savedMode = 'compact';
            try { savedMode = localStorage.getItem('tx_display_mode') || 'compact'; } catch(e){}
            setDisplayMode(savedMode);

            var tableColumnsKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DefaultTableKey));
            var serverConfigJson = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TableColumnsConfig));
            if (window.TableColumns) {
                window.TableColumns.init({
                    tableId: 'transactionsTable',
                    tableKey: tableColumnsKey,
                    serverConfigJson: serverConfigJson,
                    saveUrl: window.location.pathname + '?handler=SaveColumnsConfig'
                });
            }
        });
    </script>
