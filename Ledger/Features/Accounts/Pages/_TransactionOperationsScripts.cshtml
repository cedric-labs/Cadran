        function cleanTransactionLabelJs(label, rawLabel) {
            var target = label || rawLabel || '';
            if (!target) return '';
            var text = target.toUpperCase();
            text = text.replace(/^(PRLV|PRELEVEMENT|PRLV SEPA|VIR|VIREMENT|VIR SEPA|PAIEMENT PAR CARTE|CARTE|CB|COTIS|COTISATION)\s+/g, ' ');
            text = text.replace(/^(DE|DU|POUR)\s+/g, ' ');
            text = text.replace(/\b\d{1,2}[\/\.\-]\d{1,2}([\/\.\-]\d{2,4})?\b/g, ' ');
            text = text.replace(/\b\d{4,}\b/g, ' ');
            text = text.replace(/\b(FACTURE|REF|EMETTEUR|MANDAT|ID|NUM|NO)\b/g, ' ');
            text = text.replace(/[_\*#:\(\)\[\]]/g, ' ');
            text = text.replace(/\s+/g, ' ').trim();

            var words = text.split(' ').filter(function(w){ return w.length > 0; });
            if (words.length === 0) return '';
            if (words.length >= 2) return words[0] + ' ' + words[1];
            return words[0];
        }

        function formatSuggestedNameJs(pattern) {
            if (!pattern) return '';
            var parts = pattern.toLowerCase().split(' ').filter(function(p){ return p.length > 0; });
            for (var i = 0; i < parts.length; i++) {
                if (parts[i].length > 0) {
                    parts[i] = parts[i].charAt(0).toUpperCase() + parts[i].slice(1);
                }
            }
            return parts.join(' ');
        }

        function updateRecurringButtonAppearance(txId, newExpenseName) {
            var btn = document.getElementById('btn-recurring-tx-' + txId);
            if (!btn) return;

            var currentCount = parseInt(btn.getAttribute('data-rec-count') || '0', 10);
            var currentAll = btn.getAttribute('data-rec-all') || '';
            var allList = currentAll ? currentAll.split(',').map(function(s){ return s.trim(); }).filter(Boolean) : [];

            if (!allList.includes(newExpenseName)) {
                allList.push(newExpenseName);
            }
            var newCount = allList.length;

            btn.setAttribute('data-rec-count', newCount);
            btn.setAttribute('data-rec-first', allList[0] || newExpenseName);
            btn.setAttribute('data-rec-all', allList.join(', '));

            // Retirer les anciennes classes de couleur
            btn.classList.remove('text-secondary', 'opacity-50', 'hover-opacity-100', 'text-success', 'text-warning', 'fw-bold');

            if (newCount === 1) {
                btn.classList.add('text-success', 'fw-bold');
                btn.title = "1 charge récurrente correspond : '" + allList[0] + "'. Cliquer pour voir ou modifier.";
            } else if (newCount > 1) {
                btn.classList.add('text-warning', 'fw-bold');
                btn.title = newCount + " charges récurrentes correspondent (" + allList.join(', ') + "). Cliquer pour voir ou modifier.";
            } else {
                btn.classList.add('text-secondary', 'opacity-50', 'hover-opacity-100');
            }
