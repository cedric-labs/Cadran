@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const availableMerchants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableMerchants.Select(m => new { id = m.Id.ToString(), name = m.Name })));

            function setupMerchantCombobox(config) {
                const searchInput = document.getElementById(config.searchInputId);
                const idInput = document.getElementById(config.idInputId);
                const newNameInput = document.getElementById(config.newNameInputId);
                const listEl = document.getElementById(config.listId);
                const clearBtn = document.getElementById(config.clearBtnId);
                const container = document.getElementById(config.containerId);

                if (!searchInput || !idInput || !newNameInput || !listEl) return null;

                function renderList(filterTerm) {
                    const term = (filterTerm || '').trim().toLowerCase();
                    const matches = availableMerchants.filter(m => !term || m.name.toLowerCase().indexOf(term) !== -1);
                    const exactMatch = availableMerchants.some(m => m.name.toLowerCase() === term);

                    let html = '';
                    if (term && !exactMatch) {
                        const safeTerm = filterTerm.trim().replace(/"/g, '&quot;').replace(/'/g, '&#39;');
                        html += `<button type="button" class="dropdown-item text-primary fw-semibold py-1 bg-primary-subtle border-bottom mb-1 btn-create-merchant-item" data-name="${safeTerm}">`
                              + `<i class="bi bi-plus-circle me-1"></i> Créer « ${filterTerm.trim()} »`
                              + `</button>`;
                    }

                    matches.slice(0, 30).forEach(m => {
                        const safeName = m.name.replace(/"/g, '&quot;').replace(/'/g, '&#39;');
                        html += `<button type="button" class="dropdown-item d-flex align-items-center justify-content-between py-1 btn-select-merchant-item" data-id="${m.id}" data-name="${safeName}">`
                              + `<span class="fw-semibold text-truncate">${m.name}</span>`
                              + `<i class="bi bi-chevron-right text-muted small" style="font-size: 0.7rem;"></i>`
                              + `</button>`;
                    });

                    if (!html) {
                        html = '<div class="p-2 text-muted small text-center">Aucun tiers trouvé</div>';
                    }

                    listEl.innerHTML = html;
                    listEl.style.display = 'block';

                    listEl.querySelectorAll('.btn-create-merchant-item').forEach(btn => {
                        btn.addEventListener('click', function (e) {
                            e.preventDefault();
                            e.stopPropagation();
                            const name = this.getAttribute('data-name');
                            idInput.value = '';
                            newNameInput.value = name;
                            searchInput.value = name;
                            hideList();
                        });
                    });

                    listEl.querySelectorAll('.btn-select-merchant-item').forEach(btn => {
                        btn.addEventListener('click', function (e) {
                            e.preventDefault();
                            e.stopPropagation();
                            const id = this.getAttribute('data-id');
                            const name = this.getAttribute('data-name');
                            idInput.value = id;
                            newNameInput.value = '';
                            searchInput.value = name;
                            hideList();
                        });
                    });
                }

                function hideList() {
                    listEl.style.display = 'none';
                }

                searchInput.addEventListener('input', function () {
                    const val = this.value.trim();
                    const exact = availableMerchants.find(m => m.name.toLowerCase() === val.toLowerCase());
                    if (exact) {
                        idInput.value = exact.id;
                        newNameInput.value = '';
                    } else if (val) {
                        idInput.value = '';
                        newNameInput.value = val;
                    } else {
                        idInput.value = '';
                        newNameInput.value = '';
                    }
                    renderList(this.value);
                });

                searchInput.addEventListener('focus', function () {
                    renderList(this.value);
                });

                if (clearBtn) {
                    clearBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        idInput.value = '';
                        newNameInput.value = '';
                        searchInput.value = '';
                        hideList();
                    });
                }

                document.addEventListener('click', function (e) {
                    if (container && !container.contains(e.target)) {
                        hideList();
                    }
                });

                return {
                    setValue: function (id, name) {
                        idInput.value = id || '';
                        newNameInput.value = '';
                        searchInput.value = name || '';
                        hideList();
                    },
                    clear: function () {
                        idInput.value = '';
                        newNameInput.value = '';
                        searchInput.value = '';
                        hideList();
                    }
                };
            }

            const createMerchantCombobox = setupMerchantCombobox({
                containerId: 'createMerchantContainer',
                searchInputId: 'createMerchantSearch',
                idInputId: 'createMerchantId',
                newNameInputId: 'createNewMerchantName',
                listId: 'createMerchantList',
                clearBtnId: 'btnCreateClearMerchant'
            });

            const editMerchantCombobox = setupMerchantCombobox({
                containerId: 'editMerchantContainer',
                searchInputId: 'editMerchantSearch',
                idInputId: 'editRuleMerchant',
                newNameInputId: 'editRuleNewMerchantName',
                listId: 'editMerchantList',
                clearBtnId: 'btnEditClearMerchant'
            });

            // --- Helper 1: Construction du motif Regex à partir du texte utilisateur et du mode ---
            function buildRegexPattern(text, matchType) {
                if (!text || text.trim() === '') return '';
                let sanitized = text.trim().replace(/%/g, '*');

                // On sépare sur les jokers * et ? pour n'échapper que le texte littéral
                const parts = sanitized.split(/(\*|\?)/);
                const escapedBody = parts.map(part => {
                    if (part === '*') return '.*';
                    if (part === '?') return '.';
                    return part.replace(/[\\^$.|+()[\]{}]/g, '\\$&');
                }).join('');

                if (matchType === 'startsWith') {
                    return '(?i)^' + escapedBody;
                } else if (matchType === 'endsWith') {
                    return '(?i)' + escapedBody + '$';
                } else if (matchType === 'exact') {
                    return '(?i)^' + escapedBody + '$';
                } else {
                    // contains
                    return '(?i)' + escapedBody;
                }
            }

            // --- Helper 2: Analyse inverse d'un motif existant pour renseigner l'assistant ---
            function parseRegexToAssistant(pattern) {
                if (!pattern) return { mode: 'assistant', matchType: 'contains', text: '' };
                let p = pattern.trim();
                let temp = p;

                if (temp.startsWith('(?i)')) {
                    temp = temp.substring(4);
                }

                let matchType = 'contains';
                if (temp.startsWith('^') && temp.endsWith('$')) {
                    matchType = 'exact';
                    temp = temp.substring(1, temp.length - 1);
                } else if (temp.startsWith('^')) {
                    matchType = 'startsWith';
                    temp = temp.substring(1);
                } else if (temp.endsWith('$')) {
                    matchType = 'endsWith';
                    temp = temp.substring(0, temp.length - 1);
                }

                // Vérifier s'il y a des méta-caractères Regex avancés non gérés par le mode simple
                // (ex: alternance |, groupes (), classes [], quantificateurs +, {})
                const hasComplexSyntax = /(?<!\\)[|(){}\[\]+]/.test(temp);
                if (hasComplexSyntax) {
                    return { mode: 'advanced', matchType: 'contains', text: '', rawPattern: pattern };
                }

                // Restauration des jokers
                let readable = temp.replace(/\.\*/g, '*');
                readable = readable.replace(/\\\./g, '___DOT___');
                readable = readable.replace(/(?<!\\)\./g, '?');
                readable = readable.replace(/___DOT___/g, '.');
                // Déséchappement des caractères
                readable = readable.replace(/\\([\\^$.|+()[\]{}?*])/g, '$1');

                return {
                    mode: 'assistant',
                    matchType: matchType,
                    text: readable,
                    rawPattern: pattern
                };
            }

            // --- Helper 3: Évaluation du test en direct ---
            function testRegexPattern(pattern, sample) {
                if (!pattern || !pattern.trim() || !sample || !sample.trim()) {
                    return { tested: false };
                }
                try {
                    let clean = pattern.trim();
                    if (clean.startsWith('(?i)')) {
                        clean = clean.substring(4);
                    }
                    const regex = new RegExp(clean, 'i');
                    return { tested: true, matches: regex.test(sample.trim()), error: null };
                } catch (err) {
                    return { tested: true, matches: false, error: err.message };
                }
            }

            function updateTestResultBadge(resultContainer, testRes) {
                if (!testRes.tested) {
                    resultContainer.innerHTML = '<span class="text-muted"><i class="bi bi-arrow-return-right me-1"></i>Saisissez un exemple ci-dessus pour vérifier instantanément la détection.</span>';
                    return;
                }
                if (testRes.error) {
                    resultContainer.innerHTML = '<span class="badge bg-danger-subtle text-danger border border-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Expression invalide : ' + testRes.error + '</span>';
                    return;
                }
                if (testRes.matches) {
                    resultContainer.innerHTML = '<span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-check-circle-fill me-1"></i>Correspondance confirmée ! L\'opération sera automatiquement reconnue.</span>';
                } else {
                    resultContainer.innerHTML = '<span class="badge bg-secondary-subtle text-secondary border"><i class="bi bi-x-circle me-1"></i>Aucune correspondance avec cet exemple de libellé.</span>';
                }
            }

            // --- Initialisation d'un bloc Assistant (Create ou Edit) ---
            function setupAssistant(containerId) {
                const container = document.getElementById(containerId);
                if (!container) return null;

                const modeRadios = container.querySelectorAll('.assistant-mode-radio');
                const guidedSection = container.querySelector('.assistant-guided-section');
                const matchTypeSelect = container.querySelector('.assistant-match-type');
                const keywordInput = container.querySelector('.assistant-keyword-input');
                const patternInput = container.querySelector('.assistant-pattern-input');
                const testInput = container.querySelector('.assistant-test-input');
                const clearTestBtn = container.querySelector('.assistant-clear-test-btn');
                const testResultContainer = container.querySelector('.assistant-test-result');

                function getMode() {
                    let m = 'assistant';
                    modeRadios.forEach(r => { if (r.checked) m = r.value; });
                    return m;
                }

                function syncPatternFromGuided() {
                    if (getMode() === 'assistant') {
                        const kw = keywordInput.value;
                        const mt = matchTypeSelect.value;
                        patternInput.value = buildRegexPattern(kw, mt);
                    }
                    runLiveTest();
                }

                function runLiveTest() {
                    const res = testRegexPattern(patternInput.value, testInput.value);
                    updateTestResultBadge(testResultContainer, res);
                }

                function onModeChange() {
                    const mode = getMode();
                    if (mode === 'assistant') {
                        guidedSection.classList.remove('d-none');
                        patternInput.readOnly = true;
                        patternInput.classList.add('bg-light');
                        syncPatternFromGuided();
                    } else {
                        guidedSection.classList.add('d-none');
                        patternInput.readOnly = false;
                        patternInput.classList.remove('bg-light');
                        runLiveTest();
                    }
                }

                modeRadios.forEach(r => r.addEventListener('change', onModeChange));
                matchTypeSelect.addEventListener('change', syncPatternFromGuided);
                keywordInput.addEventListener('input', syncPatternFromGuided);
                patternInput.addEventListener('input', runLiveTest);
                testInput.addEventListener('input', runLiveTest);

                if (clearTestBtn) {
                    clearTestBtn.addEventListener('click', function () {
                        testInput.value = '';
                        runLiveTest();
                    });
                }

                onModeChange();

                return {
                    setValues: function (pattern, testSample) {
                        const parsed = parseRegexToAssistant(pattern);
                        modeRadios.forEach(r => {
                            r.checked = (r.value === parsed.mode);
                        });
                        if (parsed.mode === 'assistant') {
                            matchTypeSelect.value = parsed.matchType;
                            keywordInput.value = parsed.text;
                        }
                        patternInput.value = pattern || '';
                        if (testSample !== undefined) {
                            testInput.value = testSample;
                        }
                        onModeChange();
                        runLiveTest();
                    },
                    setSample: function(sample) {
                        testInput.value = sample;
                        runLiveTest();
                    }
                };
            }

            // Configurer l'assistant de création
            const createAssistant = setupAssistant('createAssistantContainer');

            // Configurer l'assistant d'édition
            const editAssistant = setupAssistant('editAssistantContainer');

            // Gestion des boutons d'exemples du guide
            document.querySelectorAll('.btn-apply-guide-example').forEach(btn => {
                btn.addEventListener('click', function () {
                    const name = this.getAttribute('data-name');
                    const mode = this.getAttribute('data-mode');
                    const keyword = this.getAttribute('data-keyword');
                    const pattern = this.getAttribute('data-pattern');
                    const sample = this.getAttribute('data-sample');

                    // Déplier le formulaire de création si replié
                    const collapseEl = document.getElementById('newRuleCollapse');
                    const bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapseEl, { toggle: false });
                    bsCollapse.show();

                    document.getElementById('createRuleName').value = name || '';

                    if (mode === 'advanced') {
                        createAssistant.setValues(pattern, sample);
                    } else {
                        const matchMode = this.getAttribute('data-mode-type') || 'contains';
                        document.getElementById('createMatchType').value = matchMode;
                        document.getElementById('createKeywordInput').value = keyword || '';
                        document.getElementById('createModeAssistant').checked = true;
                        createAssistant.setValues(buildRegexPattern(keyword, matchMode), sample);
                    }

                    collapseEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            });

            // Gestion de l'ouverture du Modal d'édition
            const editModalEl = document.getElementById('editRuleModal');
            const editModal = editModalEl ? new bootstrap.Modal(editModalEl) : null;

            document.querySelectorAll('.btn-edit-rule').forEach(btn => {
                btn.addEventListener('click', function () {
                    const ruleId = this.getAttribute('data-rule-id');
                    const name = this.getAttribute('data-rule-name');
                    const pattern = this.getAttribute('data-rule-pattern');
                    const priority = this.getAttribute('data-rule-priority');
                    const categoryId = this.getAttribute('data-rule-category-id');
                    const accountId = this.getAttribute('data-rule-account-id');
                    const minAmount = this.getAttribute('data-rule-min-amount');
                    const maxAmount = this.getAttribute('data-rule-max-amount');

                    document.getElementById('editRuleId').value = ruleId || '';
                    document.getElementById('editRuleName').value = name || '';
                    document.getElementById('editRulePriority').value = priority || '10';
                    document.getElementById('editRuleCategory').value = categoryId || '';
                    const merchantId = this.getAttribute('data-rule-merchant-id') || '';
                    const merchantName = this.getAttribute('data-rule-merchant-name') || '';
                    if (editMerchantCombobox) {
                        editMerchantCombobox.setValue(merchantId, merchantName);
                    }
                    document.getElementById('editRuleAccount').value = accountId || '';
                    document.getElementById('editRuleMinAmount').value = minAmount || '';
                    document.getElementById('editRuleMaxAmount').value = maxAmount || '';
                    document.getElementById('editRuleShiftToNextMonth').checked = (this.getAttribute('data-rule-shift-next') === 'true');

                    if (editAssistant) {
                        editAssistant.setValues(pattern, '');
                    }

                    if (editModal) {
                        editModal.show();
                    }
                });
            });

            // Gestion du Modal d'application / forçage des règles
            const applyModalEl = document.getElementById('applyRulesModal');
            const applyModal = applyModalEl ? new bootstrap.Modal(applyModalEl) : null;

            document.querySelectorAll('.btn-apply-single-rule').forEach(btn => {
                btn.addEventListener('click', function () {
                    const ruleId = this.getAttribute('data-rule-id');
                    const ruleSelect = document.getElementById('applyModalRuleSelect');
                    if (ruleSelect) {
                        ruleSelect.value = ruleId || '';
                    }
                    if (applyModal) {
                        applyModal.show();
                    }
                });
            });

            const openApplyBtn = document.querySelector('.btn-open-apply-modal');
            if (openApplyBtn) {
                openApplyBtn.addEventListener('click', function () {
                    const ruleSelect = document.getElementById('applyModalRuleSelect');
                    if (ruleSelect) {
                        ruleSelect.value = '';
                    }
                });
            }

            // Gestion de la recherche / filtrage en direct dans le tableau des règles
            const rulesSearchInput = document.getElementById('rulesSearchInput');
            const rulesResetSearchBtn = document.getElementById('rulesResetSearchBtn');
            const rulesTableBody = document.getElementById('rulesTableBody');
            const noMatchingRulesRow = document.getElementById('noMatchingRulesRow');
            const rulesFilteredBadge = document.getElementById('rulesFilteredBadge');

            if (rulesSearchInput && rulesTableBody) {
                const ruleRows = Array.from(rulesTableBody.querySelectorAll('tr')).filter(tr => tr.id !== 'noMatchingRulesRow');
                const totalRulesCount = ruleRows.length;

                function applyRulesFilter() {
                    const query = (rulesSearchInput.value || '').trim().toLowerCase();
                    let visibleCount = 0;

                    ruleRows.forEach(row => {
                        const text = (row.textContent || '').toLowerCase();
                        if (!query || text.includes(query)) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    if (noMatchingRulesRow) {
                        if (visibleCount === 0 && totalRulesCount > 0) {
                            noMatchingRulesRow.classList.remove('d-none');
                        } else {
                            noMatchingRulesRow.classList.add('d-none');
                        }
                    }

                    if (rulesFilteredBadge) {
                        if (query) {
                            rulesFilteredBadge.classList.remove('d-none');
                            rulesFilteredBadge.textContent = `${visibleCount} / ${totalRulesCount}`;
                        } else {
                            rulesFilteredBadge.classList.add('d-none');
                        }
                    }
                }

                rulesSearchInput.addEventListener('input', applyRulesFilter);

                if (rulesResetSearchBtn) {
                    rulesResetSearchBtn.addEventListener('click', function () {
                        rulesSearchInput.value = '';
                        applyRulesFilter();
                        rulesSearchInput.focus();
                    });
                }
            }

            // Défilement automatique et mise en valeur de la règle modifiée ou créée
            const updatedRuleId = '@(TempData["UpdatedRuleId"] ?? "")';
            const hashRuleId = window.location.hash && window.location.hash.startsWith('#rule-')
                ? window.location.hash.substring(6)
                : '';
            const targetRuleId = updatedRuleId || hashRuleId;

            if (targetRuleId) {
                const targetRow = document.getElementById('rule-' + targetRuleId);
                if (targetRow) {
                    setTimeout(() => {
                        targetRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        targetRow.classList.add('table-primary');
                        setTimeout(() => {
                            targetRow.classList.remove('table-primary');
                        }, 2500);
                    }, 150);
                }
            }

        })();
    </script>
}
