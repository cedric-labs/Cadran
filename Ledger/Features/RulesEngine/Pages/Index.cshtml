@page "/RulesEngine"
@model Ledger.Features.RulesEngine.Pages.IndexModel
@{
    ViewData["Title"] = Localizer["Rules.Title"];
    Layout = "_Layout";
}

<div class="container-fluid py-3">
    <style>
        tr[id^="rule-"] {
            scroll-margin-top: 80px;
        }
        .rule-row {
            transition: background-color 1.5s ease-out;
        }
    </style>
    <!-- En-tête -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-lightning-charge-fill text-primary me-2"></i>@Localizer["Rules.Title"]
            </h1>
            <p class="text-muted small mb-0">@Localizer["Rules.Subtitle"]</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#rulesGuideCollapse" aria-expanded="false">
                <i class="bi bi-question-circle me-1"></i> @Localizer["Rules.GuideBtn"]
            </button>
            <button class="btn btn-success btn-sm btn-open-apply-modal" type="button" data-bs-toggle="modal" data-bs-target="#applyRulesModal">
                <i class="bi bi-lightning-charge-fill me-1"></i> @Localizer["Rules.ApplyBtn"]
            </button>
            <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#newRuleCollapse" aria-expanded="false" id="btnToggleNewRule">
                <i class="bi bi-plus-lg me-1"></i> @Localizer["Rules.AddBtn"]
            </button>
        </div>
    </div>

    <!-- Alertes -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    }

    <!-- Guide interactif & Exemples (collapsible) -->
    <div class="collapse mb-4" id="rulesGuideCollapse">
        <div class="card shadow-sm border-0 border-start border-4 border-info">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 class="h6 fw-bold text-dark mb-0">
                        <i class="bi bi-book-half text-info me-2"></i>Guide pratique : Créer des règles de catégorisation facilement
                    </h5>
                    <button type="button" class="btn-close btn-sm" data-bs-toggle="collapse" data-bs-target="#rulesGuideCollapse"></button>
                </div>

                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <h6 class="fw-bold small text-primary mb-2">
                                <i class="bi bi-stars me-1"></i> 1. Les Jokers à votre disposition
                            </h6>
                            <p class="small text-muted mb-2">
                                Pas besoin d'être informaticien ! Vous pouvez taper des mots ou des jokers simples :
                            </p>
                            <ul class="small text-muted ps-3 mb-0">
                                <li class="mb-1">
                                    <code class="text-primary fw-bold">*</code> ou <code class="text-primary fw-bold">%</code> : remplace <strong>n'importe quel texte</strong> ou suite de caractères.
                                    <br><span class="text-secondary fst-italic">Ex: AXA*21767 trouvera "AXA CONTRAT 21767" ou "AXA FRANCE 2176789".</span>
                                </li>
                                <li>
                                    <code class="text-primary fw-bold">?</code> : remplace <strong>un seul caractère</strong> quelconque.
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <h6 class="fw-bold small text-primary mb-2">
                                <i class="bi bi-funnel me-1"></i> 2. Les Conditions de correspondance
                            </h6>
                            <ul class="small text-muted ps-3 mb-0">
                                <li class="mb-2">
                                    <strong>🔍 Contient</strong> : La règle s'active si le texte est présent n'importe où dans le libellé bancaire. <em>(Mode le plus recommandé !)</em>
                                </li>
                                <li class="mb-2">
                                    <strong>🏁 Commence par</strong> : Utile pour cibler un préfixe bancaire précis (ex: <code>PRLVT SEPA</code> ou <code>VIR INST</code>).
                                </li>
                                <li class="mb-2">
                                    <strong>🛑 Termine par</strong> : Utile si un identifiant se trouve en toute fin d'intitulé.
                                </li>
                                <li>
                                    <strong>🎯 Égal à</strong> : Le libellé complet doit correspondre exactement.
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <h6 class="fw-bold small text-primary mb-2">
                                <i class="bi bi-lightbulb me-1"></i> 3. Exemples prêts à l'emploi
                            </h6>
                            <p class="small text-muted mb-2">Cliquez pour pré-remplir l'assistant d'ajout :</p>
                            <div class="d-flex flex-column gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary text-start btn-apply-guide-example"
                                        data-name="Assurance Auto AXA"
                                        data-mode="contains"
                                        data-keyword="AXA*CONTRAT%21767"
                                        data-sample="VIR SEPA AXA FRANCE IARD CONTRAT 2176789 ECHEANCE">
                                    <span class="fw-semibold">Assurance AXA</span> : <code>AXA*CONTRAT%21767</code>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary text-start btn-apply-guide-example"
                                        data-name="Échéance Prêt Immobilier"
                                        data-mode="contains"
                                        data-keyword="ECHEANCE PRET*00987"
                                        data-sample="PRLVT SEPA ECHEANCE PRET N 00987452 MENSUALITE">
                                    <span class="fw-semibold">Prêt Immobilier</span> : <code>ECHEANCE PRET*00987</code>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary text-start btn-apply-guide-example"
                                        data-name="Courses Grandes Surfaces"
                                        data-mode="advanced"
                                        data-pattern="(?i)(carrefour|auchan|leclerc|lidl|monoprix)"
                                        data-sample="CB LECLERC DRIVE 24/09">
                                    <span class="fw-semibold">Grandes Surfaces</span> : <code>(carrefour|auchan|...)</code>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulaire d'ajout de règle (collapsible) -->
    <div class="collapse mb-4" id="newRuleCollapse">
        <div class="card shadow-sm border-0 border-top border-4 border-primary">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="h6 fw-bold mb-0 text-primary">
                        <i class="bi bi-plus-circle me-1"></i> Créer une nouvelle règle de catégorisation
                    </h5>
                    <button type="button" class="btn-close btn-sm" data-bs-toggle="collapse" data-bs-target="#newRuleCollapse"></button>
                </div>

                <form method="post" asp-page-handler="Create" id="createRuleForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Input.Name" for="createRuleName" class="form-label small fw-semibold">@Localizer["Rules.RuleName"]</label>
                            <input asp-for="Input.Name" class="form-control form-control-sm" id="createRuleName" aria-label="@Localizer["Rules.RuleName"]" placeholder="Ex: Assurance Auto AXA, Courses Lidl..." required />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.TargetCategoryId" for="createRuleCategory" class="form-label small fw-semibold">@Localizer["Rules.AssignedCategory"]</label>
                            <select asp-for="Input.TargetCategoryId" id="createRuleCategory" aria-label="@Localizer["Rules.AssignedCategory"]" class="form-select form-select-sm" required>
                                <option value="">@Localizer["Rules.ChooseCategory"]</option>
                                @foreach (var parent in Model.ParentCategories)
                                {
                                    var parentName = Model.CategoryTranslations.TryGetValue(parent.Id, out var pTr) && !string.IsNullOrWhiteSpace(pTr) ? pTr : parent.Name;
                                    <optgroup label="📁 @parentName.ToUpper()">
                                        <option value="@parent.Id">▶ @parentName (@Localizer["Categories.EditParent"])</option>
                                        @foreach (var cat in parent.SubCategories.OrderBy(c => c.Name))
                                        {
                                            var catName = Model.CategoryTranslations.TryGetValue(cat.Id, out var cTr) && !string.IsNullOrWhiteSpace(cTr) ? cTr : cat.Name;
                                            <option value="@cat.Id">&nbsp;&nbsp;&nbsp;• @catName</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <span asp-validation-for="Input.TargetCategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 position-relative" id="createMerchantContainer">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Input.TargetMerchantId" for="createMerchantSearch" class="form-label small fw-semibold mb-0">@Localizer["Merchants.Merchant"]</label>
                                <a href="/Merchants" class="small text-muted text-decoration-none" target="_blank" style="font-size: 0.72rem;">
                                    <i class="bi bi-gear me-1"></i>@Localizer["Merchants.ManageMerchants"]
                                </a>
                            </div>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-shop"></i></span>
                                <input type="text" class="form-control" id="createMerchantSearch" 
                                       aria-label="@Localizer["Merchants.SearchOrAdd"]"
                                       placeholder="@Localizer["Merchants.SearchOrAdd"]" 
                                       autocomplete="off" />
                                <button type="button" class="btn btn-outline-secondary" id="btnCreateClearMerchant" title="@Localizer["Common.Clear"]">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                            <input type="hidden" asp-for="Input.TargetMerchantId" id="createMerchantId" />
                            <input type="hidden" asp-for="Input.NewMerchantName" id="createNewMerchantName" />
                            <div id="createMerchantList" class="dropdown-menu w-100 shadow border p-1" style="max-height: 200px; overflow-y: auto; display: none; position: absolute; z-index: 1060;"></div>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Input.Priority" class="form-label small fw-semibold"></label>
                            <input asp-for="Input.Priority" class="form-control form-control-sm" type="number" min="1" max="1000" />
                            <span class="form-text text-muted" style="font-size: 0.7rem;">1 = priorité maximale</span>
                        </div>
                    </div>

                    <!-- Assistant de Motif Regex (Create) -->
                    <div class="card border-primary border-opacity-25 bg-light bg-opacity-50 p-3 mb-3 rounded-3" id="createAssistantContainer">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <div class="fw-bold small text-primary">
                                <i class="bi bi-magic me-1"></i> Assistant de création de motif
                            </div>
                            <div class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check assistant-mode-radio" name="createModeRadio" id="createModeAssistant" value="assistant" checked autocomplete="off">
                                <label class="btn btn-outline-primary btn-sm py-0 px-2" for="createModeAssistant">
                                    <i class="bi bi-stars me-1"></i> Assistant guidé
                                </label>
                                <input type="radio" class="btn-check assistant-mode-radio" name="createModeRadio" id="createModeAdvanced" value="advanced" autocomplete="off">
                                <label class="btn btn-outline-primary btn-sm py-0 px-2" for="createModeAdvanced">
                                    <i class="bi bi-code-slash me-1"></i> Mode expert (Regex)
                                </label>
                            </div>
                        </div>

                        <!-- Section Assistant Guidé -->
                        <div class="assistant-guided-section mb-3">
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label for="createMatchType" class="form-label small text-muted mb-1">Condition de détection</label>
                                    <select class="form-select form-select-sm assistant-match-type" id="createMatchType" aria-label="Condition de détection">
                                        <option value="contains" selected>🔍 Le libellé contient</option>
                                        <option value="startsWith">🏁 Le libellé commence par</option>
                                        <option value="endsWith">🛑 Le libellé se termine par</option>
                                        <option value="exact">🎯 Le libellé est exactement égal à</option>
                                    </select>
                                </div>
                                <div class="col-md-8">
                                    <label for="createKeywordInput" class="form-label small text-muted mb-1">
                                        Texte ou mots-clés recherchés
                                        <span class="badge bg-white text-secondary border ms-1 fw-normal">Jokers * et % acceptés</span>
                                    </label>
                                    <input type="text" class="form-control form-control-sm assistant-keyword-input" id="createKeywordInput"
                                           aria-label="Texte ou mots-clés recherchés"
                                           placeholder="Ex: AXA*CONTRAT ou LECLERC ou PRET" />
                                </div>
                            </div>
                            <div class="small text-muted mt-1" style="font-size: 0.75rem;">
                                <i class="bi bi-info-circle text-primary me-1"></i>
                                Tapez simplement votre texte. Les jokers <code>*</code> ou <code>%</code> remplacent n'importe quels caractères. Les symboles sont automatiquement protégés.
                            </div>
                        </div>

                        <!-- Champ Pattern Regex -->
                        <div class="mb-3">
                            <label asp-for="Input.Pattern" for="createPatternInput" class="form-label small fw-semibold mb-1">
                                Formule de détection (Regex)
                            </label>
                            <input asp-for="Input.Pattern" class="form-control form-control-sm font-monospace assistant-pattern-input" id="createPatternInput" aria-label="Formule de détection (Regex)" required />
                            <span asp-validation-for="Input.Pattern" class="text-danger small"></span>
                        </div>

                        <!-- Testeur en direct -->
                        <div class="border-top pt-2">
                            <label for="createTestInput" class="form-label small fw-semibold text-dark mb-1">
                                <i class="bi bi-play-circle text-success me-1"></i> Tester sur un exemple de libellé bancaire réel :
                            </label>
                            <div class="input-group input-group-sm mb-1">
                                <input type="text" class="form-control assistant-test-input" id="createTestInput"
                                       aria-label="Tester sur un exemple de libellé bancaire réel"
                                       placeholder="Collez ici un exemple de libellé de votre compte pour vérifier..." />
                                <button class="btn btn-outline-secondary assistant-clear-test-btn" type="button" title="Effacer">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="assistant-test-result mt-1 small">
                                <span class="text-muted"><i class="bi bi-arrow-return-right me-1"></i>Saisissez un exemple ci-dessus pour vérifier instantanément la détection.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Filtres optionnels (Compte, Montants) -->
                    <div class="accordion mb-3" id="createOptionalFiltersAccordion">
                        <div class="accordion-item border rounded">
                            <h2 class="accordion-header" id="headingCreateFilters">
                                <button class="accordion-button collapsed py-2 px-3 bg-white text-muted small fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCreateFilters">
                                    <i class="bi bi-sliders me-2 text-primary"></i> Filtres additionnels optionnels (Compte bancaire, Plage de montants)
                                </button>
                            </h2>
                            <div id="collapseCreateFilters" class="accordion-collapse collapse" data-bs-parent="#createOptionalFiltersAccordion">
                                <div class="accordion-body p-3 bg-light bg-opacity-25">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="Input.TargetBankAccountId" class="form-label small fw-semibold"></label>
                                            <select asp-for="Input.TargetBankAccountId" class="form-select form-select-sm">
                                                <option value="">-- S'applique à tous les comptes --</option>
                                                @foreach (var acc in Model.AvailableAccounts)
                                                {
                                                    <option value="@acc.Id">@acc.Name (@(acc.Bank?.Name ?? "Banque"))</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label asp-for="Input.MinAmount" class="form-label small fw-semibold"></label>
                                            <div class="input-group input-group-sm">
                                                <input asp-for="Input.MinAmount" class="form-control" type="number" step="0.01" placeholder="Ex: 50.00" />
                                                <span class="input-group-text">€</span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label asp-for="Input.MaxAmount" class="form-label small fw-semibold"></label>
                                            <div class="input-group input-group-sm">
                                                <input asp-for="Input.MaxAmount" class="form-control" type="number" step="0.01" placeholder="Ex: 500.00" />
                                                <span class="input-group-text">€</span>
                                            </div>
                                        </div>
                                        <div class="col-12 mt-2">
                                            <div class="form-check form-switch p-2 bg-white rounded border">
                                                <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Input.ShiftToNextMonth" id="createShiftToNextMonth">
                                                <label class="form-check-label small fw-semibold" for="createShiftToNextMonth">
                                                    <i class="bi bi-calendar-plus text-primary me-1"></i> Reporter la date budgétaire sur le mois suivant (+1 mois)
                                                </label>
                                                <div class="small text-muted ms-4">
                                                    Idéal pour les salaires reçus vers le 25 du mois : le montant sera comptabilisé sur le budget du mois suivant.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#newRuleCollapse">Annuler</button>
                        <button type="submit" class="btn btn-primary btn-sm ms-2">
                            <i class="bi bi-check-lg me-1"></i> Créer la règle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Tableau des règles actives -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 class="h5 fw-bold mb-0">
                <i class="bi bi-list-check me-2 text-primary"></i><span id="rulesHeaderCount">@string.Format(Localizer["Rules.ActiveRulesOrdered"], Model.Rules.Count)</span>
            </h2>
            <span class="badge bg-light text-muted border small">
                @Localizer["Rules.PriorityHelpBadge"]
            </span>
        </div>

        @if (Model.Rules.Any())
        {
            <div class="p-3 bg-light border-bottom">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="rulesSearchInput" class="form-control border-start-0" 
                                   aria-label="@Localizer["Rules.SearchPlaceholder"]"
                                   placeholder="@Localizer["Rules.SearchPlaceholder"]" />
                        </div>
                    </div>
                    <div class="col-auto">
                        <button type="button" id="rulesResetSearchBtn" class="btn btn-outline-secondary btn-sm" title="@Localizer["Common.Cancel"]">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </div>
                    <div class="col text-end">
                        <span id="rulesFilteredBadge" class="badge bg-light text-dark border d-none"></span>
                    </div>
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="rulesTable">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 75px;">@Localizer["Rules.Priority"]</th>
                        <th>@Localizer["Rules.RuleName"]</th>
                        <th>@Localizer["Rules.DetectionCriteria"]</th>
                        <th>@Localizer["Rules.AssignedCategory"]</th>
                        <th>@Localizer["Merchants.Merchant"]</th>
                        <th>@Localizer["Rules.BankAccount"]</th>
                        <th>@Localizer["Rules.Amounts"]</th>
                        <th class="text-end" style="width: 120px;">@Localizer["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody id="rulesTableBody">
                    @if (!Model.Rules.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-lightning-charge fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <span class="fw-semibold">@Localizer["Rules.NoRules"]</span>
                                <p class="small text-muted mb-3">@Localizer["Rules.NoRulesSubtitle"]</p>
                                <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#newRuleCollapse">
                                    <i class="bi bi-plus-lg me-1"></i> @Localizer["Rules.AddFirstRule"]
                                </button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var rule in Model.Rules)
                        {
                            <tr id="rule-@rule.Id" class="rule-row">
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary font-monospace px-2 py-1">@rule.Priority</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@rule.Name</span>
                                    @if (rule.ShiftToNextMonth)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle small ms-1" title="La date budgétaire est automatiquement décalée au mois suivant (+1 mois)">
                                            <i class="bi bi-calendar-plus me-1"></i> +1 mois
                                        </span>
                                    }
                                </td>
                                <td>
                                    <code class="p-1 px-2 bg-light rounded text-dark font-monospace small border">@rule.Pattern</code>
                                </td>
                                <td>
                                    @if (rule.TargetCategory != null)
                                    {
                                        var catName = Model.CategoryTranslations.TryGetValue(rule.TargetCategory.Id, out var cTr) && !string.IsNullOrWhiteSpace(cTr) ? cTr : rule.TargetCategory.Name;
                                        <span class="badge rounded-pill border" style="background-color: @(rule.TargetCategory.ColorHex)15; color: @rule.TargetCategory.ColorHex; border-color: @(rule.TargetCategory.ColorHex)40 !important;">
                                            <i class="bi @rule.TargetCategory.IconName me-1"></i> @catName
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (rule.TargetMerchant != null)
                                    {
                                        <span class="badge rounded-pill border" style="background-color: @(rule.TargetMerchant.ColorHex ?? "#6366f1")15; color: @(rule.TargetMerchant.ColorHex ?? "#6366f1"); border-color: @(rule.TargetMerchant.ColorHex ?? "#6366f1")40 !important;">
                                            <i class="bi @(rule.TargetMerchant.IconName ?? "bi-shop") me-1"></i> @rule.TargetMerchant.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted">@(rule.TargetBankAccount?.Name ?? "Tous les comptes")</span>
                                </td>
                                <td>
                                    @if (rule.MinAmount.HasValue || rule.MaxAmount.HasValue)
                                    {
                                        <span class="badge bg-light text-dark border small">
                                            @(rule.MinAmount.HasValue ? $"≥ {rule.MinAmount.Value:N2}€" : "")
                                            @(rule.MinAmount.HasValue && rule.MaxAmount.HasValue ? " et " : "")
                                            @(rule.MaxAmount.HasValue ? $"≤ {rule.MaxAmount.Value:N2}€" : "")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-success btn-apply-single-rule p-1 px-2"
                                                data-rule-id="@rule.Id"
                                                data-rule-name="@rule.Name"
                                                title="Appliquer cette règle aux opérations...">
                                            <i class="bi bi-play-fill"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-primary btn-edit-rule p-1 px-2"
                                                data-rule-id="@rule.Id"
                                                data-rule-name="@rule.Name"
                                                data-rule-pattern="@rule.Pattern"
                                                data-rule-priority="@rule.Priority"
                                                data-rule-category-id="@rule.TargetCategoryId"
                                                data-rule-merchant-id="@(rule.TargetMerchantId?.ToString() ?? "")"
                                                data-rule-merchant-name="@(rule.TargetMerchant?.Name ?? "")"
                                                data-rule-account-id="@(rule.TargetBankAccountId?.ToString() ?? "")"
                                                data-rule-min-amount="@(rule.MinAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                data-rule-max-amount="@(rule.MaxAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                data-rule-shift-next="@(rule.ShiftToNextMonth ? "true" : "false")"
                                                title="Modifier la règle">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@rule.Id" class="d-inline" onsubmit="return confirm('Confirmer la suppression de la règle « @rule.Name » ?');">
                                            <button type="submit" class="btn btn-outline-danger p-1 px-2" title="Supprimer la règle">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    <tr id="noMatchingRulesRow" class="d-none">
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-funnel text-secondary fs-3 d-block mb-2"></i>
                            <span>@Localizer["Rules.NoMatchingRules"]</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

