@page "/Security/Register"
@model Ledger.Features.Security.Pages.RegisterModel
@{
    ViewData["Title"] = Localizer["Nav.Register"];
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock-fill text-primary display-4"></i>
                    <h2 class="h4 mt-2">@Localizer["Auth.RegisterTitle"]</h2>
                    <p class="text-muted small">@Localizer["Auth.RegisterSubtitle"]</p>
                </div>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.FullName" class="form-label small fw-semibold">@Localizer["Auth.FullName"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input asp-for="Input.FullName" class="form-control" placeholder="@Localizer["Auth.FullNamePlaceholder"]" />
                        </div>
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label small fw-semibold">@Localizer["Auth.Email"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Input.Email" class="form-control" placeholder="@Localizer["Auth.EmailPlaceholder"]" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label small fw-semibold">@Localizer["Auth.Password"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                            <input asp-for="Input.Password" class="form-control" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label small fw-semibold">@Localizer["Auth.ConfirmPassword"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-check2-circle"></i></span>
                            <input asp-for="Input.ConfirmPassword" class="form-control" />
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-person-plus me-1"></i> @Localizer["Auth.RegisterButton"]
                    </button>
                </form>

                <div class="text-center mt-3 pt-3 border-top">
                    <span class="small text-muted">@Localizer["Auth.AlreadyHaveAccount"] </span>
                    <a href="/Security/Login" class="small text-decoration-none">@Localizer["Auth.SignInButton"]</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
