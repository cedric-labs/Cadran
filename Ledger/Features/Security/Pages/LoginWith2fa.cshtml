@page "/Security/LoginWith2fa"
@model Ledger.Features.Security.Pages.LoginWith2faModel
@{
    ViewData["Title"] = Localizer["Auth.MfaLoginTitle"];
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 rounded-circle bg-warning bg-opacity-10 text-warning mb-2">
                        <i class="bi bi-shield-check fs-2"></i>
                    </div>
                    <h2 class="h4">@Localizer["Auth.MfaLoginHeading"]</h2>
                    <p class="text-muted small">@Localizer["Auth.MfaLoginSubtitle"]</p>
                </div>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.TwoFactorCode" for="inputTwoFactorCode" class="form-label small fw-semibold">@Localizer["Auth.TwoFactorCode"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-123"></i></span>
                            <input asp-for="Input.TwoFactorCode" id="inputTwoFactorCode" class="form-control text-center fs-4 letter-spacing-2" autocomplete="off" placeholder="123456" maxlength="7" />
                        </div>
                        <span asp-validation-for="Input.TwoFactorCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Input.RememberMachine" id="inputRememberMachine" class="form-check-input" />
                        <label asp-for="Input.RememberMachine" for="inputRememberMachine" class="form-check-label small">@Localizer["Auth.RememberMachine"]</label>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 py-2 fw-semibold">
                        <i class="bi bi-check-circle me-1"></i> @Localizer["Auth.ValidateCode"]
                    </button>
                </form>

                <div class="text-center mt-3 pt-3 border-top">
                    <a href="/Security/Login" class="small text-muted text-decoration-none">
                        <i class="bi bi-arrow-left"></i> @Localizer["Auth.BackToLogin"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
