@page "/Security/DatabaseEncryption"
@model Ledger.Features.Security.Pages.DatabaseEncryptionModel
@{
    ViewData["Title"] = Localizer["DbEnc.PageTitle"];
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="d-flex align-items-center">
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3 me-3">
                        <i class="bi bi-safe2 fs-3"></i>
                    </div>
                    <div>
                        <h1 class="h3 mb-0">@Localizer["DbEnc.PageTitle"]</h1>
                        <p class="text-muted small mb-0">@Localizer["DbEnc.PageSubtitle"]</p>
                    </div>
                </div>

                @if (Model.IsEncrypted)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 fs-6">
                        <i class="bi bi-shield-check me-1"></i> @Localizer["DbEnc.BadgeEncrypted"]
                    </span>
                }
                else
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle px-3 py-2 fs-6">
                        <i class="bi bi-shield-slash me-1"></i> @Localizer["DbEnc.BadgePlain"]
                    </span>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div>@Model.StatusMessage</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>@Model.ErrorMessage</div>
                </div>
            }

            <!-- Explication de la sécurité et portabilité -->
            <div class="card bg-light border-0 mb-4">
                <div class="card-body p-3">
                    <div class="d-flex gap-3">
                        <i class="bi bi-info-circle-fill text-primary fs-4"></i>
                        <div class="small">
                            <strong>@Localizer["DbEnc.InfoTitle"] :</strong> @Localizer["DbEnc.InfoDescription"]
                        </div>
                    </div>
                </div>
            </div>

            @if (!Model.IsEncrypted)
            {
                <!-- Section 1 : Activer le chiffrement -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="card-title h6 mb-0 text-primary fw-bold">
                            <i class="bi bi-lock-fill me-2"></i> @Localizer["DbEnc.ActivateTitle"]
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted small">
                            @Localizer["DbEnc.ActivateDescription"]
                        </p>

                        <form method="post" asp-page-handler="Encrypt">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="encryptNewPassphrase" class="form-label small fw-semibold">@Localizer["DbEnc.NewPassphraseLabel"]</label>
                                    <input asp-for="EncryptInput.NewPassphrase" id="encryptNewPassphrase" type="password" class="form-control" required minlength="8" placeholder="••••••••••••" />
                                    <div class="form-text small">@Localizer["DbEnc.PassphraseRequirements"]</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="encryptConfirmPassphrase" class="form-label small fw-semibold">@Localizer["DbEnc.ConfirmPassphraseLabel"]</label>
                                    <input asp-for="EncryptInput.ConfirmPassphrase" id="encryptConfirmPassphrase" type="password" class="form-control" required minlength="8" placeholder="••••••••••••" />
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input asp-for="EncryptInput.RememberOnDevice" class="form-check-input" id="encryptRemember" />
                                        <label class="form-check-label small" for="encryptRemember">
                                            @Localizer["DbEnc.RememberOnDeviceLabel"]
                                        </label>
                                        <div class="form-text small text-muted">@Localizer["DbEnc.RememberOnDeviceHint"]</div>
                                    </div>
                                </div>
                                <div class="col-12 pt-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-shield-lock me-1"></i> @Localizer["DbEnc.ActivateButton"]
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <!-- Section 2 : Modifier la phrase de passe (Rekey) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="card-title h6 mb-0 fw-bold">
                            <i class="bi bi-key-fill text-primary me-2"></i> @Localizer["DbEnc.RekeyTitle"]
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" asp-page-handler="ChangePassphrase">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label for="rekeyCurrentPassphrase" class="form-label small fw-semibold">@Localizer["DbEnc.CurrentPassphraseLabel"]</label>
                                    <input asp-for="ChangePassphraseInput.CurrentPassphrase" id="rekeyCurrentPassphrase" type="password" class="form-control" required placeholder="••••••••••••" />
                                </div>
                                <div class="col-md-6">
                                    <label for="rekeyNewPassphrase" class="form-label small fw-semibold">@Localizer["DbEnc.NewPassphraseLabel"]</label>
                                    <input asp-for="ChangePassphraseInput.NewPassphrase" id="rekeyNewPassphrase" type="password" class="form-control" required minlength="8" placeholder="••••••••••••" />
                                </div>
                                <div class="col-md-6">
                                    <label for="rekeyConfirmPassphrase" class="form-label small fw-semibold">@Localizer["DbEnc.ConfirmPassphraseLabel"]</label>
                                    <input asp-for="ChangePassphraseInput.ConfirmPassphrase" id="rekeyConfirmPassphrase" type="password" class="form-control" required minlength="8" placeholder="••••••••••••" />
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input asp-for="ChangePassphraseInput.RememberOnDevice" class="form-check-input" id="rekeyRemember" />
                                        <label class="form-check-label small" for="rekeyRemember">
                                            @Localizer["DbEnc.RememberOnDeviceLabel"]
                                        </label>
                                    </div>
                                </div>
                                <div class="col-12 pt-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-arrow-repeat me-1"></i> @Localizer["DbEnc.RekeyButton"]
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Section 3 : Mémorisation sur cet appareil -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="card-title h6 mb-0 fw-bold">
                            <i class="bi bi-laptop text-primary me-2"></i> @Localizer["DbEnc.RememberDeviceSectionTitle"]
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold small">
                                    @Localizer["DbEnc.AutoUnlockStatusLabel"] : 
                                    @if (Model.IsRememberOnDevice)
                                    {
                                        <span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>@Localizer["DbEnc.StatusActive"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary fw-bold"><i class="bi bi-x-circle me-1"></i>@Localizer["DbEnc.StatusInactive"]</span>
                                    }
                                </div>
                                <div class="text-muted small mt-1">
                                    @Localizer["DbEnc.RememberDeviceDescription"]
                                </div>
                            </div>
                            <form method="post" asp-page-handler="ToggleRemember">
                                <input type="hidden" name="remember" value="@((!Model.IsRememberOnDevice).ToString().ToLowerInvariant())" />
                                @if (Model.IsRememberOnDevice)
                                {
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash me-1"></i> @Localizer["DbEnc.ForgetDeviceButton"]
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-bookmark-check me-1"></i> @Localizer["DbEnc.RememberDeviceButton"]
                                    </button>
                                }
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Section 4 : Déchiffrer la base (Zone de danger) -->
                <div class="card border-danger border-opacity-50 shadow-sm">
                    <div class="card-header bg-danger bg-opacity-10 border-danger border-opacity-25 py-3">
                        <h5 class="card-title h6 mb-0 text-danger fw-bold">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Localizer["DbEnc.DangerZoneTitle"]
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted small">
                            @Localizer["DbEnc.DecryptWarning"]
                        </p>

                        <form method="post" asp-page-handler="Decrypt" onsubmit="return confirm('@Html.Raw(Localizer["DbEnc.ConfirmDecryptPrompt"])');">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-7">
                                    <label for="decryptCurrentPassphrase" class="form-label small fw-semibold">@Localizer["DbEnc.CurrentPassphraseLabel"]</label>
                                    <input asp-for="DecryptInput.CurrentPassphrase" id="decryptCurrentPassphrase" type="password" class="form-control" required placeholder="••••••••••••" />
                                </div>
                                <div class="col-md-5">
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-unlock me-1"></i> @Localizer["DbEnc.DecryptButton"]
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
