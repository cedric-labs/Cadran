@page "/Categories"
@model Ledger.Features.Categories.Pages.IndexModel
@{
    ViewData["Title"] = Localizer["Categories.Title"];
    Layout = "_Layout";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">@Localizer["Categories.Title"]</h1>
            <p class="text-muted small mb-0">@Localizer["Categories.Subtitle"]</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnToggleAllCategories">
                <i class="bi bi-arrows-collapse me-1"></i> @Localizer["Categories.ToggleAll"]
            </button>
            <form method="post" asp-page-handler="RestoreDefaults" class="d-inline" onsubmit="return confirm('@Localizer["Categories.RestoreDefaultsConfirm"]');">
                <button type="submit" class="btn btn-outline-primary btn-sm" title="@Localizer["Categories.RestoreDefaults"]">
                    <i class="bi bi-arrow-repeat me-1"></i> @Localizer["Categories.RestoreDefaults"]
                </button>
            </form>
            <a href="/Categories/CreateOrEdit" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> @Localizer["Categories.NewCategory"]
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-@(Model.StatusMessageType ?? "info") alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi @(Model.StatusMessageType == "success" ? "bi-check-circle-fill" : "bi-info-circle-fill") me-2 fs-5"></i>
            <div>@Model.StatusMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.ParentCategories.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <div class="text-muted mb-3"><i class="bi bi-tags display-3"></i></div>
            <h4>@Localizer["Categories.NoCategories"]</h4>
            <p class="text-muted">@Localizer["Categories.NoCategoriesDesc"]</p>
            <div class="mt-2 d-flex justify-content-center gap-2">
                <a href="/Categories/CreateOrEdit" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> @Localizer["Categories.CreateCategory"]
                </a>
                <form method="post" asp-page-handler="RestoreDefaults" class="d-inline">
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-repeat me-1"></i> @Localizer["Categories.RestoreDefaults"]
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var parent in Model.ParentCategories)
            {
                var parentName = Model.CategoryTranslations.TryGetValue(parent.Id, out var pTr) && !string.IsNullOrWhiteSpace(pTr) ? pTr : parent.Name;
                <div class="card shadow-sm border-0 category-group-card">
                    <!-- En-tête de la Grande Catégorie -->
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                 style="width: 36px; height: 36px; background-color: @parent.ColorHex; color: #fff;">
                                <i class="bi @parent.IconName fs-5"></i>
                            </div>
                            <div>
                                <span class="h5 fw-bold text-uppercase mb-0 text-dark">@parentName</span>
                                <span class="badge @(parent.IsIncome ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") ms-2 small">
                                    @(parent.IsIncome ? Localizer["Categories.Incomes"] : Localizer["Categories.Expenses"])
                                </span>
                                @if (parent.IsSalary)
                                {
                                    <span class="badge bg-success text-white ms-1 small" title="@Localizer["Categories.SalaryBadgeTitle"]">
                                        <i class="bi bi-cash-stack me-1"></i>@Localizer["Categories.Salary"]
                                    </span>
                                }
                                <span class="badge bg-light text-muted border ms-1 small">
                                    @string.Format(Localizer["Categories.SubcategoriesCount"], parent.SubCategories.Count)
                                </span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-link btn-sm text-decoration-none text-muted p-0 me-2 toggle-collapse-btn" 
                                    type="button" 
                                    data-bs-toggle="collapse" 
                                    data-bs-target="#collapse-@parent.Id" 
                                    aria-expanded="true">
                                <span class="toggle-text">@Localizer["Categories.Hide"]</span>
                            </button>

                            <div class="dropdown">
                                <button class="btn btn-light btn-sm" data-bs-toggle="dropdown" title="@Localizer["Categories.EditParent"]">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-item small" href="/Categories/CreateOrEdit/@parent.Id">
                                            <i class="bi bi-pencil me-2 text-primary"></i> @Localizer["Categories.EditParent"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item small" href="/Categories/CreateOrEdit?parentId=@parent.Id">
                                            <i class="bi bi-plus-circle me-2 text-success"></i> @Localizer["Categories.AddSubcategory"]
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@parent.Id" onsubmit="return confirm('@Localizer["Categories.DeleteParentConfirm"]');">
                                            <button type="submit" class="dropdown-item small text-danger">
                                                <i class="bi bi-trash me-2"></i> @Localizer["Categories.Delete"]
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Sous-catégories associées -->
                    <div id="collapse-@parent.Id" class="collapse show border-top">
                        <div class="card-body p-3 bg-light bg-opacity-25">
                            @if (!parent.SubCategories.Any())
                            {
                                <div class="text-muted small py-2 px-1 fst-italic">
                                    @Localizer["Categories.NoSubcategoriesYet"]
                                </div>
                            }
                            else
                            {
                                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                                    @foreach (var sub in parent.SubCategories.OrderBy(s => s.Name))
                                    {
                                        var subName = Model.CategoryTranslations.TryGetValue(sub.Id, out var sTr) && !string.IsNullOrWhiteSpace(sTr) ? sTr : sub.Name;
                                        <div class="col">
                                            <div class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-white border shadow-none hover-shadow transition">
                                                <div class="d-flex align-items-center gap-2 overflow-hidden me-2">
                                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                                         style="width: 28px; height: 28px; background-color: @(sub.ColorHex)20; color: @sub.ColorHex;">
                                                        <i class="bi @sub.IconName small"></i>
                                                    </div>
                                                    <span class="small fw-semibold text-truncate" title="@subName">@subName</span>
                                                    @if (sub.IsSalary)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size: 0.65rem;" title="@Localizer["Categories.SalaryBadgeTitle"]">
                                                            <i class="bi bi-cash-stack me-1"></i>@Localizer["Categories.Salary"]
                                                        </span>
                                                    }
                                                </div>

                                                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                    <a href="/Categories/CreateOrEdit/@sub.Id" class="small text-muted text-decoration-none hover-primary" title="@Localizer["Categories.Edit"]">
                                                        @Localizer["Categories.Edit"]
                                                    </a>
                                                    <form method="post" asp-page-handler="Delete" asp-route-id="@sub.Id" class="d-inline" onsubmit="return confirm('@string.Format(Localizer["Categories.DeleteSubConfirm"], subName)');">
                                                        <button type="submit" class="btn btn-link p-0 small text-danger text-decoration-none" title="@Localizer["Categories.Delete"]">
                                                            @Localizer["Categories.Delete"]
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Bouton Ajouter une sous-catégorie -->
                            <div class="mt-3 pt-2">
                                <a href="/Categories/CreateOrEdit?parentId=@parent.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-plus-circle me-1"></i> @Localizer["Categories.AddSubcategory"]
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.OrphanCategories.Any())
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0">
                        <span class="h6 fw-bold text-uppercase mb-0 text-muted">@Localizer["Categories.OtherCategories"]</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                            @foreach (var orphan in Model.OrphanCategories)
                            {
                                var orphanName = Model.CategoryTranslations.TryGetValue(orphan.Id, out var oTr) && !string.IsNullOrWhiteSpace(oTr) ? oTr : orphan.Name;
                                <div class="col">
                                    <div class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-light border">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi @orphan.IconName text-secondary"></i>
                                            <span class="small fw-semibold">@orphanName</span>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a href="/Categories/CreateOrEdit/@orphan.Id" class="small text-muted text-decoration-none">@Localizer["Categories.Edit"]</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Gestion du texte 'masquer' / 'afficher'
            document.querySelectorAll('.toggle-collapse-btn').forEach(function (btn) {
                var targetId = btn.getAttribute('data-bs-target');
                var targetEl = document.querySelector(targetId);
                var textEl = btn.querySelector('.toggle-text');

                if (targetEl && textEl) {
                    targetEl.addEventListener('hidden.bs.collapse', function () {
                        textEl.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Categories.Show"].Value));
                    });
                    targetEl.addEventListener('shown.bs.collapse', function () {
                        textEl.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Categories.Hide"].Value));
                    });
                }
            });

            // Tout replier / Tout déplier
            var toggleAllBtn = document.getElementById('btnToggleAllCategories');
            if (toggleAllBtn) {
                var allOpen = true;
                toggleAllBtn.addEventListener('click', function () {
                    var collapses = document.querySelectorAll('.category-group-card .collapse');
                    collapses.forEach(function (c) {
                        var bsCollapse = bootstrap.Collapse.getInstance(c) || new bootstrap.Collapse(c, { toggle: false });
                        if (allOpen) {
                            bsCollapse.hide();
                        } else {
                            bsCollapse.show();
                        }
                    });
                    allOpen = !allOpen;
                });
            }
        });
    </script>
}
